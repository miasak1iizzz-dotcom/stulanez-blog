import Layout from "@/layouts/Layout.astro";
import CleanupMonitor from "@/components/lab/CleanupMonitor.svelte";
---
<Layout title="图库清理监控" description="T-011 Kpop 全库清理挂机进度监控(内部)">
	<meta name="robots" content="noindex, nofollow" slot="head" />
	<main class="mx-auto min-h-screen w-full max-w-5xl px-4 py-10">
		<h1 class="mb-1 text-xl font-black text-white">🧹 T-011 图库清理 · 挂机监控</h1>
