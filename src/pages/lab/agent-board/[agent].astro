---
import Layout from "@/layouts/Layout.astro";
import HeaderTopRow from "@/components/layout/HeaderTopRow.astro";
import { siteConfig } from "@/config";
import agentsData from "@/data/agent-board/agents.json";
import tasksData from "@/data/agent-board/tasks.json";
import {
	deriveAgentStatus,
	getClaimsFor,
	ownerToAgentId,
	TASK_CATEGORIES,
	isClaimActive,
	loadReportsFor,
	type AgentInfo,
	type ClaimCard,
	type Task,
} from "@/utils/agent-board";

export async function getStaticPaths() {
	const agents = (await import("@/data/agent-board/agents.json")).default as AgentInfo[];
	return agents
		.filter((a) => a.id !== "user")
		.map((a) => ({ params: { agent: a.id }, props: { agent: a } }));
}

const { agent } = Astro.props as { agent: AgentInfo };
const tasks = (tasksData as { tasks: Task[] }).tasks;
const claims: ClaimCard[] = getClaimsFor(agent.id);
const activeClaims = claims.filter((c) => isClaimActive(c.status));

const mine = (t: Task) => ownerToAgentId(t.owner) === agent.id;
const myActive = tasks.filter((t) => mine(t) && (t.state === "doing" || t.state === "review"));
const myQueue = tasks.filter((t) => mine(t) && (t.state === "backlog" || t.state === "blocked"));
const myDone = tasks.filter((t) => mine(t) && t.state === "done");
const derived = deriveAgentStatus(agent, claims, tasks);
const reports = loadReportsFor(agent.id);

const stateChip: Record<string, { label: string; cls: string }> = {
	doing: { label: "● 进行中", cls: "bg-sky-400/10 text-sky-300 ring-sky-400/30" },
	review: { label: "◉ 等你验收", cls: "bg-[#e6c26e]/10 text-[#e6c26e] ring-[#e6c26e]/30" },
	blocked: { label: "⛔ 卡住", cls: "bg-rose-400/10 text-rose-300 ring-rose-400/30" },
	backlog: { label: "○ 排队中", cls: "bg-white/5 text-zinc-400 ring-white/10" },
	done: { label: "✔ 已完成", cls: "bg-emerald-400/10 text-emerald-300 ring-emerald-400/30" },
};

const summaryDocs = agent.summaries.map((s) => ({
	path: s,
	title: s.split("/").pop()?.replace(/\.md$/, "") ?? s,
}));

const title = `${agent.name} · 指挥室`;
const description = `${agent.name} 现在在干什么、名下任务与怎么指挥他。`;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;

const directiveTemplates = [
	{
		label: "继续干",
		text: `继续推进你名下的任务（看板 /lab/agent-board/），干完记得更新看板：tasks.json 写进度，需要我过目的事写 inbox.json。`,
	},
	{
		label: "我来验收",
		text: `我来验收你在看板上的汇报（卷宗编号 N-xxx）：我的意见是——`,
	},
	{
		label: "派新活",
		text: `给你派个新任务：——（在这里写你想要什么）。请先按协作协议认领文件，把任务加进看板 tasks.json 再开工。`,
	},
];
---

<Layout {title} {description}>
	<meta slot="head" name="robots" content="noindex, nofollow, noarchive" />
	<HeaderTopRow stickyNavbar={true} navbarWidthFull={navbarWidthFull} />
	<main class="mx-auto w-full max-w-5xl px-3 pt-20 pb-16 sm:px-5 min-h-screen">
		<div class="ab-deck">
			<a
				href="/lab/agent-board/"
				data-no-swup
				class="mb-5 inline-flex items-center gap-1.5 text-xs font-bold text-zinc-500 transition-colors hover:text-[#e6c26e]"
			>
				← 返回指挥室
			</a>

			<!-- ===== 成员头部 ===== -->
			<header class="relative mb-6 overflow-hidden rounded-3xl ring-1 ring-white/10">
				<img
					src={myActive[0]?.cover ?? "/assets/images/agent-board/lol-zoe.jpg"}
					alt=""
					class="absolute inset-0 h-full w-full object-cover"
				/>
				<div
					class="absolute inset-0"
					style={`background:linear-gradient(100deg,${agent.color}26 0%,rgba(10,10,13,.9) 45%,rgba(10,10,13,.65) 100%)`}
				></div>
				<div class="relative flex flex-wrap items-center gap-4 px-6 py-10 sm:px-10 sm:py-12">
					<span
						class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl text-2xl font-black text-white ring-1 ring-white/20"
						style={`background:linear-gradient(135deg,${agent.color},color-mix(in srgb,${agent.color} 45%,#18181b));box-shadow:0 16px 40px -12px ${agent.color}88`}
					>
						{agent.name.charAt(0)}
					</span>
					<div class="min-w-0">
						<h1 class="flex flex-wrap items-center gap-2.5 text-3xl font-black text-white drop-shadow">
							{agent.name}
							<span
								class:list={[
									"rounded-full px-3 py-1 text-[11px] font-black ring-1 backdrop-blur",
									derived.key !== "idle"
										? "bg-emerald-400/15 text-emerald-300 ring-emerald-400/40"
										: "bg-white/10 text-zinc-400 ring-white/20",
								]}
							>
								{derived.key === "coding" ? "🔧 任务执行中" : derived.key === "working" ? `● ${derived.label}` : "○ 空闲"}
							</span>
						</h1>
						<p class="mt-1.5 text-xs text-zinc-400">
							{agent.vendor} · {agent.model} · 名下 {myActive.length + myQueue.length} 件没干完 / 已交付 {myDone.length} 件
						</p>
					</div>
					<p class="w-full text-sm leading-7 text-zinc-300 sm:ml-auto sm:max-w-xs sm:text-right">
						{agent.plain}
					</p>
				</div>
				<div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-[#e6c26e]/50 to-transparent"></div>
			</header>

			<!-- ===== 当前任务 ===== -->
			<section class="mb-8">
				<div class="mb-4 flex items-center gap-3">
					<span class="text-[11px] font-black tracking-[0.3em] text-[#e6c26e]">NOW</span>
					<h2 class="text-xl font-black text-white">手上在干什么</h2>
					<div class="h-px flex-1 bg-gradient-to-r from-[#e6c26e]/40 to-transparent"></div>
				</div>
				<div class="grid grid-cols-1 gap-4">
					{
						myActive.map((t) => (
							<article class="ab-card p-6">
								<div class="flex flex-wrap items-center gap-2">
									<span class="rounded bg-black/40 px-1.5 py-0.5 font-mono text-[10px] text-zinc-500">{t.id}</span>
									<span class:list={["rounded-full px-2.5 py-0.5 text-[10px] font-bold ring-1", stateChip[t.state]?.cls]}>
										{stateChip[t.state]?.label ?? t.state}
									</span>
									<span class="text-[11px] text-zinc-500">{TASK_CATEGORIES[t.cat]?.emoji} {TASK_CATEGORIES[t.cat]?.label}</span>
								</div>
								<h3 class="mt-2 text-lg font-black text-white">{t.title}</h3>
								<p class="mt-2 text-sm leading-7 text-zinc-300">{t.plain}</p>
								{t.statusLine && (
									<p class="mt-3 rounded-xl bg-[#e6c26e]/[0.07] px-3.5 py-2.5 text-xs font-bold leading-6 text-[#e6c26e] ring-1 ring-[#e6c26e]/15">
										{t.statusLine}
									</p>
								)}
								{typeof t.progress === "number" && (
									<div class="mt-3">
										<div class="mb-1 flex justify-between text-[10px] font-bold text-zinc-500">
											<span>进度</span>
											<span class="text-[#e6c26e]">{t.progress}%</span>
										</div>
										<div class="h-1.5 overflow-hidden rounded-full bg-white/8">
											<div class="ab-bar h-full rounded-full" style={`width:${t.progress}%`} />
										</div>
									</div>
								)}
								{t.nextStep && <p class="mt-3 text-xs leading-6 text-zinc-500">下一步：{t.nextStep}</p>}
							</article>
						))
					}
					{
						myActive.length === 0 && (
							<p class="ab-card p-6 text-sm leading-7 text-zinc-400">
								手上没有进行中的任务。想派活？用下面的指令模板，或者直接对他的对话框说。
							</p>
						)
					}
				</div>
			</section>

			<!-- ===== 任务档案（报告/总结） ===== -->
			<section class="mb-8">
				<div class="mb-4 flex items-center gap-3">
					<span class="text-[11px] font-black tracking-[0.3em] text-[#e6c26e]">REPORTS</span>
					<h2 class="text-xl font-black text-white">任务档案</h2>
					<div class="h-px flex-1 bg-gradient-to-r from-[#e6c26e]/40 to-transparent"></div>
					<span class="rounded-full bg-white/5 px-2.5 py-1 text-[10px] font-bold text-zinc-400 ring-1 ring-white/10">{reports.length} 条</span>
				</div>
				{
					reports.length > 0 ? (
						<div class="ab-card divide-y divide-white/8 overflow-hidden !p-0">
							{reports.map((r, i) => (
								<div class="flex gap-3.5 px-5 py-4">
									<span class="shrink-0 pt-0.5 font-mono text-[11px] font-bold text-[#e6c26e]">{String(reports.length - i).padStart(2, "0")}</span>
									<div class="min-w-0 flex-1">
										<div class="flex flex-wrap items-center gap-2">
											<span class="rounded bg-black/40 px-1.5 py-0.5 font-mono text-[10px] text-zinc-500">{r.taskRef}</span>
											<span class="text-[11px] text-zinc-500">{r.at}</span>
										</div>
										<p class="mt-1.5 text-[13px] leading-6 text-zinc-300">{r.text}</p>
									</div>
								</div>
							))}
						</div>
					) : (
						<p class="ab-card p-6 text-sm leading-7 text-zinc-400">
							还没有任务报告。干完活往
							<code class="text-zinc-500">src/data/agent-board/reports/{agent.id}.json</code>
							追加一条，这里就会显示。
						</p>
					)
				}
			</section>

			<!-- ===== 怎么指挥 + 改哪些文件 ===== -->
			<section class="mb-8 grid grid-cols-1 gap-4 lg:grid-cols-2">
				<div class="ab-card p-6">
					<h2 class="mb-3 text-base font-black text-white">怎么指挥 {agent.name}</h2>
					<div class="space-y-2.5">
						{
							directiveTemplates.map((d) => (
								<button type="button" class="group flex w-full items-center gap-3 rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-left transition-colors hover:border-[#e6c26e]/40" data-copy={d.text}>
									<span class="rounded-full bg-[#e6c26e]/10 px-2.5 py-1 text-[10px] font-black text-[#e6c26e] ring-1 ring-[#e6c26e]/30">{d.label}</span>
									<span class="min-w-0 flex-1 truncate text-xs text-zinc-400 group-hover:text-zinc-200">{d.text.slice(0, 34)}…</span>
									<span class="shrink-0 text-[11px] font-bold text-zinc-500 group-hover:text-[#e6c26e]">复制</span>
								</button>
							))
						}
					</div>
					<p class="mt-3 text-[11px] leading-5 text-zinc-600">复制后粘贴到 {agent.name} 的对话框即可。指令里已经带了让他更新看板的要求。</p>
				</div>
				<div class="ab-card p-6">
					<h2 class="mb-3 text-base font-black text-white">正在改哪些文件</h2>
					{
						activeClaims.length > 0 ? (
							<ul class="space-y-2">
								{activeClaims.map((c) => (
									<li class="rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3">
										<div class="flex items-center justify-between gap-2">
											<b class="truncate font-mono text-[11px] text-zinc-300">{c.file}</b>
											<span class="shrink-0 rounded-full bg-sky-400/10 px-2 py-0.5 text-[9px] font-bold text-sky-300 ring-1 ring-sky-400/30">进行中</span>
										</div>
										<p class="mt-1 text-[11px] text-zinc-500">{c.exclusivePaths.slice(0, 3).join("、")}{c.exclusivePaths.length > 3 ? " …" : ""}</p>
									</li>
								))}
							</ul>
						) : (
							<p class="rounded-xl border border-white/10 bg-white/[0.03] px-4 py-6 text-center text-xs leading-6 text-zinc-500">
								现在没有占用的文件（没在改代码，也不会和别人打架）。
							</p>
						)
					}
					<p class="mt-3 text-[11px] leading-5 text-zinc-600">「认领卡」是 AI 改文件前的占座登记，防止两个 AI 改同一个文件互相覆盖。</p>
				</div>
			</section>

			<!-- ===== 排队中 ===== -->
			{
				myQueue.length > 0 && (
					<section class="mb-8">
						<div class="mb-4 flex items-center gap-3">
							<span class="text-[11px] font-black tracking-[0.3em] text-[#e6c26e]">QUEUE</span>
							<h2 class="text-xl font-black text-white">他排着的活</h2>
							<div class="h-px flex-1 bg-gradient-to-r from-[#e6c26e]/40 to-transparent" />
						</div>
						<div class="ab-card grid grid-cols-1 gap-1 !p-2 md:grid-cols-2 md:gap-x-6">
							{myQueue.map((t) => (
								<div class="flex items-center gap-3 rounded-xl px-3 py-2.5">
									<span class="font-mono text-[10px] text-zinc-600">{t.id}</span>
									<span class="min-w-0 flex-1 truncate text-[13px] text-zinc-300">{t.plain || t.title}</span>
									<span class:list={["shrink-0 rounded-full px-2 py-0.5 text-[10px] font-bold ring-1", stateChip[t.state]?.cls]}>
										{t.state === "blocked" ? "⛔ 卡住" : "排队"}
									</span>
								</div>
							))}
						</div>
					</section>
				)
			}

			<!-- ===== 工作总结 ===== -->
			{
				summaryDocs.length > 0 && (
					<section class="mb-6">
						<div class="mb-4 flex items-center gap-3">
							<span class="text-[11px] font-black tracking-[0.3em] text-[#e6c26e]">DOSSIER</span>
							<h2 class="text-xl font-black text-white">工作总结档案</h2>
							<div class="h-px flex-1 bg-gradient-to-r from-[#e6c26e]/40 to-transparent" />
						</div>
						<div class="space-y-2.5">
							{summaryDocs.map((doc) => (
								<a
									href={`/lab/agent-board/${agent.id}/`}
									data-no-swup
									class="ab-card block px-5 py-4 text-sm font-bold text-zinc-300 transition-colors hover:text-white"
								>
									📄 {doc.title}（在仓库 {doc.path}，AI 之间传阅用）
								</a>
							))}
						</div>
					</section>
				)
			}

			<footer class="border-t border-white/8 pt-5 text-center text-[11px] text-zinc-600">
				内部面板 · noindex · 数据源 src/data/agent-board/ · 本地 dev 实时刷新
			</footer>
		</div>
	</main>

	<div
		id="toast"
		hidden
		class="fixed bottom-8 left-1/2 z-[70] -translate-x-1/2 rounded-full bg-gradient-to-r from-[#f7e3ae] to-[#d9a441] px-6 py-3 text-xs font-black text-[#1a1408] shadow-2xl shadow-[#e6c26e]/30"
	>
	</div>
</Layout>

<style>
	.ab-deck {
		color-scheme: dark;
		border-radius: 2.5rem;
		border: 1px solid rgb(255 255 255 / 0.08);
		background:
			radial-gradient(900px 400px at 15% -8%, rgb(230 194 110 / 0.08), transparent),
			#0a0a0d;
		padding: 1.25rem;
		box-shadow: 0 40px 120px -40px rgb(0 0 0 / 0.8);
	}
	@media (min-width: 640px) {
		.ab-deck {
			padding: 2rem;
		}
	}
	.ab-card {
		border-radius: 1.5rem;
		border: 1px solid rgb(255 255 255 / 0.09);
		background: linear-gradient(180deg, rgb(255 255 255 / 0.055), rgb(255 255 255 / 0.025));
		transition:
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}
	.ab-card:hover {
		border-color: rgb(230 194 110 / 0.35);
		box-shadow: 0 18px 50px -18px rgb(230 194 110 / 0.25);
	}
	.ab-bar {
		background: linear-gradient(90deg, #b98a35, #e6c26e, #f7e3ae, #e6c26e);
		background-size: 200% 100%;
		animation: ab-shimmer 2.6s linear infinite;
	}
	@keyframes ab-shimmer {
		from {
			background-position: 200% 0;
		}
		to {
			background-position: -200% 0;
		}
	}
</style>

<script>
	// —— 指令模板复制 ——
	function legacyCopy(text: string): void {
		const ta = document.createElement("textarea");
		ta.value = text;
		ta.style.position = "fixed";
		ta.style.opacity = "0";
		document.body.appendChild(ta);
		ta.select();
		const ok = document.execCommand("copy");
		ta.remove();
		if (!ok) throw new Error("copy failed");
	}
	const toast = document.getElementById("toast")!;
	let toastTimer: ReturnType<typeof setTimeout>;
	function showToast(msg: string) {
		toast.textContent = msg;
		toast.hidden = false;
		clearTimeout(toastTimer);
		toastTimer = setTimeout(() => (toast.hidden = true), 2400);
	}
	document.querySelectorAll<HTMLElement>("[data-copy]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const text = btn.dataset.copy ?? "";
			const write = navigator.clipboard?.writeText
				? navigator.clipboard.writeText(text).catch(() => legacyCopy(text))
				: new Promise<void>((resolve, reject) => {
						try {
							legacyCopy(text);
							resolve();
						} catch (e) {
							reject(e);
						}
					});
			write
				.then(() => showToast("✓ 已复制，粘贴给他的对话框即可"))
				.catch(() => showToast("复制失败，请手动复制"));
		});
	});
</script>
