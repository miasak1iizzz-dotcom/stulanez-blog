---
import Layout from "@/layouts/Layout.astro";
import HeaderTopRow from "@/components/layout/HeaderTopRow.astro";
import { siteConfig } from "@/config";
import agentsData from "@/data/agent-board/agents.json";
import tasksData from "@/data/agent-board/tasks.json";
import mailData from "@/data/agent-board/mail.json";
import enrichments from "@/data/agent-board/board-enrichments.json";
import {
	getClaimsFor,
	readDoc,
	ownerToAgentId,
	type AgentInfo,
	type ClaimCard,
	type Msg,
	type Task,
} from "@/utils/agent-board";

export async function getStaticPaths() {
	const agents = (await import("@/data/agent-board/agents.json")).default as AgentInfo[];
	return agents
		.filter((a) => a.id !== "user")
		.map((a) => ({ params: { agent: a.id }, props: { agent: a } }));
}

const { agent } = Astro.props as { agent: AgentInfo };
const agentById = new Map<string, AgentInfo>(agentsData.map((a) => [a.id, a]));
const nameOf = (id: string): string => agentById.get(id)?.name ?? id;
const taskEnrich = enrichments as {
	tasks: Record<string, { plain: string; cover: string; cat: string }>;
	categories: Record<string, { label: string; emoji: string }>;
	agents: Record<string, { plain: string }>;
};
const plainOf = (id: string): string => taskEnrich.tasks[id]?.plain ?? "";
const coverOf = (id: string): string => taskEnrich.tasks[id]?.cover ?? "/assets/images/agent-board/lol-zoe.jpg";

const tasks: Task[] = (tasksData as { updated: string; tasks: Task[] }).tasks.filter(
	(t) => t.owner.toLowerCase().includes(agent.id),
);
const claims: ClaimCard[] = getClaimsFor(agent.id);
const messages: Msg[] = (mailData as { messages: Msg[] }).messages.filter(
	(m) => m.from.toLowerCase().includes(agent.id) || m.to.toLowerCase().includes(agent.id),
);
const summaryDocs = agent.summaries
	.map((s) => ({ path: s, title: s.split("/").pop()?.replace(/\.md$/, "") ?? s, body: readDoc(s) }))
	.filter((d) => d.body);

const title = `${agent.name} · AI 空间`;
const description = `${agent.name} 的工作总结、认领卡与任务进度。`;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;

const stateChip: Record<string, { label: string; cls: string }> = {
	doing: { label: "进行中", cls: "bg-blue-500/10 text-blue-600 dark:text-blue-300 ring-blue-500/30" },
	blocked: { label: "等你拍板", cls: "bg-rose-500/10 text-rose-600 dark:text-rose-300 ring-rose-500/30" },
	review: { label: "待验收", cls: "bg-amber-500/10 text-amber-600 dark:text-amber-300 ring-amber-500/30" },
	backlog: { label: "排手中", cls: "bg-zinc-500/10 text-zinc-500 dark:text-zinc-300 ring-zinc-500/30" },
	done: { label: "已完成", cls: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-300 ring-emerald-500/30" },
};
const claimLabel = (s: string): string =>
	s.startsWith("active") ? "进行中" : s.startsWith("handoff") ? "已交接" : s.startsWith("done") || s.startsWith("completed") ? "已完成" : s.startsWith("paused") || s.startsWith("await") ? "已暂停" : s.includes("unknown") ? "未知" : s;
const doneCount = tasks.filter((t) => t.state === "done").length;
---

<Layout {title} {description}>
	<meta slot="head" name="robots" content="noindex, nofollow, noarchive" />
	<HeaderTopRow stickyNavbar={true} navbarWidthFull={navbarWidthFull} />
	<main class="mx-auto w-full max-w-5xl px-4 pt-20 pb-16 min-h-screen">
		<a href="/lab/agent-board/" data-no-swup class="mb-5 inline-flex items-center gap-1 text-xs text-zinc-400 transition-colors hover:text-zinc-600 dark:hover:text-zinc-300">← 返回指挥中心</a>

		<header class="relative mb-8 overflow-hidden rounded-3xl ring-1 ring-zinc-900/10 dark:ring-white/10">
			<img src={coverOf(tasks.find((t) => t.state !== "done")?.id ?? tasks[0]?.id ?? "T-016")} alt="" class="absolute inset-0 h-full w-full object-cover" />
			<div class="absolute inset-0" style={`background:linear-gradient(100deg, ${agent.color}f0 0%, ${agent.color}cc 30%, rgba(9,9,11,0.82) 68%, rgba(9,9,11,0.55) 100%)`}></div>
			<div class="relative flex items-center gap-4 px-6 py-9 sm:px-9">
				<span class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-white/15 text-2xl font-extrabold text-white shadow-lg ring-1 ring-white/30 backdrop-blur">{agent.name.charAt(0)}</span>
				<div class="min-w-0">
					<h1 class="flex flex-wrap items-center gap-2 text-2xl font-extrabold text-white drop-shadow">
						{agent.name}
						<span class:list={["rounded-full px-2.5 py-1 text-[11px] font-bold ring-1 backdrop-blur", agent.status === "working" ? "bg-emerald-400/20 text-emerald-100 ring-emerald-300/40" : "bg-white/10 text-white/70 ring-white/25"]}>{agent.status === "working" ? "● 工作中" : "○ 空闲"}</span>
					</h1>
					<p class="mt-1 text-xs text-white/70">{agent.vendor} · {agent.model}{agent.port ? ` · 本地端口 ${agent.port}` : ""} · 完成 {doneCount}/{tasks.length} 项任务</p>
				</div>
			</div>
		</header>

		<p class="mb-8 rounded-2xl bg-white px-5 py-4 text-sm leading-relaxed text-zinc-600 ring-1 ring-zinc-200 dark:bg-zinc-900 dark:text-zinc-300 dark:ring-zinc-800">
			<span class="mr-1.5 font-bold text-zinc-900 dark:text-zinc-50">一句话介绍：</span>{taskEnrich.agents[agent.id]?.plain ?? agent.role}
		</p>

		<div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2">
			<section>
				<h2 class="mb-3 flex items-center gap-2 text-sm font-bold text-zinc-900 dark:text-zinc-50">
					<span class="h-4 w-1 rounded-full bg-gradient-to-b from-violet-400 to-fuchsia-400"></span>
					任务档案
				</h2>
				<div class="space-y-2.5">
					{tasks.map((t) => (
						<div class="group flex overflow-hidden rounded-2xl bg-white ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-zinc-800">
							<div class="w-20 shrink-0">
								<img src={coverOf(t.id)} alt="" class="h-full w-full object-cover" loading="lazy" />
							</div>
							<div class="min-w-0 flex-1 p-3.5">
								<div class="flex flex-wrap items-center gap-1.5">
									<span class="font-mono text-[9px] text-zinc-400">{t.id}</span>
									<span class:list={["rounded-full px-2 py-0.5 text-[9px] font-bold ring-1", stateChip[t.state]?.cls ?? stateChip.backlog.cls]}>{stateChip[t.state]?.label ?? t.state}</span>
								</div>
								<h3 class="mt-1 text-xs font-bold text-zinc-900 dark:text-zinc-50">{t.title}</h3>
								<p class="mt-0.5 line-clamp-2 text-[11px] leading-relaxed text-zinc-400 dark:text-zinc-500">{plainOf(t.id) || t.brief}</p>
							</div>
						</div>
					))}
					{tasks.length === 0 && <p class="rounded-2xl bg-white p-5 text-xs text-zinc-400 ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-zinc-800">暂无任务</p>}
				</div>
			</section>

			<section>
				<h2 class="mb-3 flex items-center gap-2 text-sm font-bold text-zinc-900 dark:text-zinc-50">
					<span class="h-4 w-1 rounded-full bg-gradient-to-b from-sky-400 to-blue-400"></span>
					认领卡（文件占座）
					<span class="rounded-full bg-zinc-500/10 px-2 text-[10px] font-bold text-zinc-400">{claims.length}</span>
				</h2>
				<div class="space-y-2">
					{claims.map((c) => (
						<div class="rounded-xl bg-white px-3.5 py-2.5 ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-zinc-800">
							<div class="flex items-center justify-between gap-2">
								<b class="truncate font-mono text-[11px] text-zinc-600 dark:text-zinc-300">{c.file}</b>
								<span class:list={["shrink-0 rounded-full px-2 py-0.5 text-[9px] font-bold", c.status.startsWith("active") ? "bg-blue-500/10 text-blue-600 dark:text-blue-300" : c.status.startsWith("handoff") ? "bg-amber-500/10 text-amber-600 dark:text-amber-300" : "bg-zinc-500/10 text-zinc-400"]}>{claimLabel(c.status)}</span>
							</div>
							{c.task && c.task !== c.file && <p class="mt-0.5 truncate text-[10px] text-zinc-400">{c.task}</p>}
						</div>
					))}
					{claims.length === 0 && <p class="rounded-2xl bg-white p-5 text-xs text-zinc-400 ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-zinc-800">暂无认领卡（没在改代码）</p>}
				</div>

				<h2 class="mb-3 mt-6 flex items-center gap-2 text-sm font-bold text-zinc-900 dark:text-zinc-50">
					<span class="h-4 w-1 rounded-full bg-gradient-to-b from-amber-400 to-orange-400"></span>
					工作总结
				</h2>
				<div class="space-y-2.5">
					{summaryDocs.map((doc) => (
						<details class="group overflow-hidden rounded-2xl bg-white ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-zinc-800">
							<summary class="cursor-pointer select-none px-4 py-3 text-xs font-bold text-zinc-600 transition-colors hover:bg-zinc-50 dark:text-zinc-300 dark:hover:bg-zinc-800/50">📄 {doc.title}</summary>
							<pre class="ab-scroll max-h-[420px] overflow-auto whitespace-pre-wrap border-t border-zinc-100 px-4 py-4 font-sans text-xs leading-relaxed text-zinc-600 dark:border-zinc-800 dark:text-zinc-300">{doc.body}</pre>
						</details>
					))}
					{summaryDocs.length === 0 && <p class="rounded-2xl bg-white p-5 text-xs text-zinc-400 ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-zinc-800">暂无总结文档</p>}
				</div>
			</section>
		</div>

		<section>
			<h2 class="mb-3 flex items-center gap-2 text-sm font-bold text-zinc-900 dark:text-zinc-50">
				<span class="h-4 w-1 rounded-full bg-gradient-to-b from-rose-400 to-pink-400"></span>
				相关信件
			</h2>
			<div class="space-y-2.5">
				{messages.map((m) => (
					<div class="rounded-2xl bg-white p-4 ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-zinc-800">
						<p class="text-[10px] text-zinc-400">{nameOf(ownerToAgentId(m.from))} → {nameOf(ownerToAgentId(m.to))} · {m.task} · {m.time}</p>
						<p class="mt-1 text-xs leading-relaxed text-zinc-700 dark:text-zinc-200">{m.body}</p>
						{m.reply && <p class="mt-2 rounded-xl bg-violet-500/5 px-3 py-2 text-xs leading-relaxed text-violet-600 ring-1 ring-violet-500/15 dark:text-violet-300">↩ {m.reply}</p>}
					</div>
				))}
				{messages.length === 0 && <p class="rounded-2xl bg-white p-5 text-xs text-zinc-400 ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-zinc-800">暂无信件</p>}
			</div>
		</section>
	</main>
</Layout>

<style>
	.ab-scroll::-webkit-scrollbar {
		width: 5px;
	}
	.ab-scroll::-webkit-scrollbar-thumb {
		border-radius: 9999px;
		background: rgb(161 161 170 / 0.4);
	}
</style>
