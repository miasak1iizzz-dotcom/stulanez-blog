---
import Layout from "@/layouts/Layout.astro";
import HeaderTopRow from "@/components/layout/HeaderTopRow.astro";
import { siteConfig } from "@/config";
import agentsData from "@/data/agent-board/agents.json";
import tasksData from "@/data/agent-board/tasks.json";
import mailData from "@/data/agent-board/mail.json";
import {
	getClaimsFor,
	readDoc,
	type AgentInfo,
	type ClaimCard,
	type Msg,
	type Task,
} from "@/utils/agent-board";

export async function getStaticPaths() {
	const agents = (await import("@/data/agent-board/agents.json")).default as AgentInfo[];
	return agents
		.filter((a) => a.id !== "user")
		.map((a) => ({ params: { agent: a.id }, props: { agent: a } }));
}

const { agent } = Astro.props as { agent: AgentInfo };
const agentById = new Map<string, AgentInfo>(agentsData.map((a) => [a.id, a]));
const nameOf = (id: string) => agentById.get(id)?.name ?? id;

const tasks: Task[] = (tasksData as { updated: string; tasks: Task[] }).tasks.filter(
	(t) => t.owner.toLowerCase().includes(agent.id),
);
const claims: ClaimCard[] = getClaimsFor(agent.id);
const messages: Msg[] = (mailData as { messages: Msg[] }).messages.filter(
	(m) => m.from.toLowerCase().includes(agent.id) || m.to.toLowerCase().includes(agent.id),
);
const summaryDocs = agent.summaries
	.map((s) => ({ path: s, title: s.split("/").pop()?.replace(/\.md$/, "") ?? s, body: readDoc(s) }))
	.filter((d) => d.body);

const title = `${agent.name} · Agent 空间`;
const description = `${agent.name} 的工作总结、认领卡与任务进度。`;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;

const prioLabel = (p: string): string => (p === "P0" ? "紧急" : p === "P1" ? "高" : p === "P2" ? "中" : "低");
const prioClass = (p: string): string =>
	p === "P0" ? "text-red-500 dark:text-red-400" : p === "P1" ? "text-amber-600 dark:text-amber-400" : "text-zinc-400";
const claimLabel = (s: string): string =>
	s.startsWith("active") ? "进行中" : s.startsWith("handoff") ? "已交接" : s.startsWith("done") || s.startsWith("completed") ? "已完成" : s.startsWith("paused") || s.startsWith("await") ? "已暂停" : s.includes("unknown") ? "未知" : s;
---

<Layout {title} {description}>
	<HeaderTopRow stickyNavbar={true} navbarWidthFull={navbarWidthFull} />
	<main class="mx-auto w-full max-w-5xl px-4 pt-24 pb-16 min-h-screen">
		<a href="/lab/agent-board/" data-no-swup class="inline-flex items-center gap-1 text-xs text-zinc-400 dark:text-zinc-500 hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors mb-6">
			← 返回协作中心
		</a>

		<header class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 mb-8">
			<div class="flex items-center gap-4">
				<span
					class="grid place-items-center w-14 h-14 rounded-2xl text-white text-2xl font-bold shrink-0"
					style={`background:linear-gradient(135deg,${agent.color},color-mix(in srgb,${agent.color} 55%,#0ea5e9))`}
				>{agent.name.charAt(0)}</span>
				<div>
					<h1 class="text-xl font-bold text-zinc-900 dark:text-zinc-50">{agent.name}</h1>
					<p class="text-xs text-zinc-400 dark:text-zinc-500 mt-0.5">{agent.vendor} · {agent.model}{agent.port ? ` · 端口 ${agent.port}` : ""}</p>
				</div>
			</div>
			<p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">{agent.role}</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
			<section>
				<h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-3">任务进度</h2>
				<div class="space-y-2">
					{tasks.map((t) => (
						<div class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-3">
							<div class="flex items-start justify-between gap-2">
								<h3 class="text-[13px] font-medium text-zinc-800 dark:text-zinc-200">{t.title}</h3>
								<span class:list={["shrink-0 text-[10px] px-1.5 py-0.5 rounded-full font-medium",
									t.state === "done" ? "bg-emerald-100 text-emerald-600 dark:bg-emerald-500/15 dark:text-emerald-400"
									: t.state === "doing" ? "bg-blue-100 text-blue-600 dark:bg-blue-500/15 dark:text-blue-400"
									: t.state === "blocked" ? "bg-red-100 text-red-500 dark:bg-red-500/15 dark:text-red-400"
									: "bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400"]}>
									{t.state === "done" ? "已完成" : t.state === "doing" ? "进行中" : t.state === "blocked" ? "受阻" : "待办"}
								</span>
							</div>
							<p class="mt-1 text-[11px] text-zinc-400 dark:text-zinc-500">{t.brief}</p>
						</div>
					))}
					{tasks.length === 0 && <p class="text-xs text-zinc-400 dark:text-zinc-600">暂无任务</p>}
				</div>
			</section>

			<section>
				<h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-3">认领卡 <span class="normal-case font-normal">{claims.length}</span></h2>
				<div class="space-y-2">
					{claims.map((c) => (
						<div class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-3 py-2.5">
							<div class="flex items-center justify-between gap-2">
								<b class="text-xs font-mono text-zinc-600 dark:text-zinc-300">{c.file}</b>
								<span class:list={["shrink-0 text-[10px] px-1.5 py-0.5 rounded-full",
									c.status.startsWith("active") ? "bg-blue-100 text-blue-600 dark:bg-blue-500/15 dark:text-blue-400"
									: c.status.startsWith("handoff") ? "bg-amber-100 text-amber-600 dark:bg-amber-500/15 dark:text-amber-400"
									: "bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400"]}>
									{claimLabel(c.status)}
								</span>
							</div>
							{c.task && c.task !== c.file && <p class="mt-1 text-[11px] text-zinc-500 dark:text-zinc-400">{c.task}</p>}
						</div>
					))}
					{claims.length === 0 && <p class="text-xs text-zinc-400 dark:text-zinc-600">暂无认领卡</p>}
				</div>
			</section>
		</div>

		<section class="mb-8">
			<h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-3">工作总结</h2>
			{summaryDocs.length === 0 && <p class="text-xs text-zinc-400 dark:text-zinc-600">暂无总结文档</p>}
			<div class="space-y-3">
				{summaryDocs.map((doc) => (
					<details class="group rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 overflow-hidden">
						<summary class="px-4 py-3 cursor-pointer text-sm font-medium text-zinc-700 dark:text-zinc-300 select-none hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors">
							{doc.title}
						</summary>
						<pre class="px-4 py-4 max-h-[480px] overflow-auto text-xs leading-relaxed text-zinc-600 dark:text-zinc-300 whitespace-pre-wrap font-sans border-t border-zinc-100 dark:border-zinc-800">{doc.body}</pre>
					</details>
				))}
				{summaryDocs.length === 0 && <p class="text-xs text-zinc-400 dark:text-zinc-600">暂无总结文档</p>}
			</div>
		</section>

		<section>
			<h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-3">相关信件</h2>
			<div class="space-y-2">
				{messages.map((m) => (
					<div class="border-l-2 border-zinc-200 dark:border-zinc-700 pl-3 py-2">
						<p class="text-[10px] text-zinc-400 dark:text-zinc-500">{nameOf(m.from)} → {nameOf(m.to)} · {m.time}</p>
						<p class="text-xs text-zinc-600 dark:text-zinc-300 mt-0.5">{m.body}</p>
						{m.reply && <p class="text-xs text-emerald-600 dark:text-emerald-400 mt-1">↳ {m.reply}</p>}
					</div>
				))}
				{messages.length === 0 && <p class="text-xs text-zinc-400 dark:text-zinc-600">暂无信件</p>}
			</div>
		</section>
	</main>
</Layout>
