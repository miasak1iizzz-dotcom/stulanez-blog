---
import Layout from "@/layouts/Layout.astro";
import HeaderTopRow from "@/components/layout/HeaderTopRow.astro";
import { siteConfig } from "@/config";
import agentsData from "@/data/agent-board/agents.json";
import tasksData from "@/data/agent-board/tasks.json";
import decisionsData from "@/data/agent-board/decisions.json";
import mailData from "@/data/agent-board/mail.json";
import experienceData from "@/data/agent-board/experience.json";
import enrichments from "@/data/agent-board/board-enrichments.json";
import currentStateMd from "@/data/agent-board/CURRENT-STATE.md?raw";
import {
	getBoardWriteLock,
	getClaimConflicts,
	getClaims,
	getSharedBoardClaimViolations,
	isClaimActive,
	ownerToAgentId,
	type AgentInfo,
	type ClaimCard,
	type Decision,
	type Exp,
	type Msg,
	type Task,
} from "@/utils/agent-board";

const title = "AI 指挥中心";
const description = "永恒欲望多代理协作看板：任务、决策、进度与团队。";
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;

const agents = agentsData as AgentInfo[];
const tasks = (tasksData as { updated: string; tasks: Task[] }).tasks;
const decisions = (decisionsData as { items: Decision[] }).items;
const messages = (mailData as { messages: Msg[] }).messages;
const exps = (experienceData as { entries: Exp[] }).entries;
const claims = getClaims();
const claimConflicts = getClaimConflicts(claims);
const sharedBoardClaimViolations = getSharedBoardClaimViolations(claims);
const boardWriteLock = getBoardWriteLock();
const coordinationIssueCount = claimConflicts.length + sharedBoardClaimViolations.length;

type Enrichment = { plain: string; cover: string; cat: string };
const taskEnrich = enrichments as {
	categories: Record<string, { label: string; emoji: string }>;
	tasks: Record<string, Enrichment>;
	agents: Record<string, { plain: string }>;
	decisions: Record<string, { plain: string; copy: string }>;
	quarantineNote: string;
};
const catOf = (id: string): string => taskEnrich.tasks[id]?.cat ?? "ops";
const plainOf = (id: string): string => taskEnrich.tasks[id]?.plain ?? "";
const coverOf = (id: string): string => taskEnrich.tasks[id]?.cover ?? "/assets/images/agent-board/lol-zoe.jpg";

const agentById = new Map<string, AgentInfo>(agents.map((a) => [a.id, a]));
const nameOf = (id: string): string => agentById.get(id)?.name ?? id;
const colorOf = (id: string): string => agentById.get(id)?.color ?? "#a1a1aa";
const ownerAgentId = (owner: string): string => ownerToAgentId(owner);
const plainAgent = (id: string): string => taskEnrich.agents[id]?.plain ?? "";

const byState = (s: string): Task[] => tasks.filter((t) => t.state === s);
const stateMeta: Record<string, { label: string; hint: string; chip: string; dot: string }> = {
	doing: { label: "进行中", hint: "AI 正在干", chip: "bg-blue-500/10 text-blue-600 dark:text-blue-300 ring-blue-500/30", dot: "bg-blue-400" },
	blocked: { label: "等你拍板", hint: "卡住，需要老板决定", chip: "bg-rose-500/10 text-rose-600 dark:text-rose-300 ring-rose-500/30", dot: "bg-rose-400" },
	review: { label: "待验收", hint: "干完了，等老板过目", chip: "bg-amber-500/10 text-amber-600 dark:text-amber-300 ring-amber-500/30", dot: "bg-amber-400" },
	backlog: { label: "排手中", hint: "排队等着做", chip: "bg-zinc-500/10 text-zinc-600 dark:text-zinc-300 ring-zinc-500/30", dot: "bg-zinc-400" },
	done: { label: "已完成", hint: "验收通过", chip: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-300 ring-emerald-500/30", dot: "bg-emerald-400" },
};
const stateOrder = ["doing", "blocked", "review", "backlog", "done"];

const pendingDecisions = decisions.filter((d) => d.status === "pending");
const doingTasks = byState("doing");
const activeClaims = claims.filter((c) => isClaimActive(c.status));

// 给 JS 的任务数据（弹窗详情用）
const tasksForJs = tasks.map((t) => ({
	id: t.id,
	title: t.title,
	owner: t.owner,
	ownerName: nameOf(ownerAgentId(t.owner)),
	ownerColor: colorOf(ownerAgentId(t.owner)),
	state: t.state,
	stateLabel: stateMeta[t.state]?.label ?? t.state,
	priority: t.priority,
	plain: plainOf(t.id),
	brief: t.brief,
	deps: t.deps,
	artifacts: t.artifacts,
	cover: coverOf(t.id),
	cat: catOf(t.id),
	catLabel: taskEnrich.categories[catOf(t.id)]?.label ?? "",
}));

// CURRENT-STATE.md 解析成分节
function parseCurrentState(md: string): { title: string; lead?: string; items: string[] }[] {
	const sections: { title: string; lead?: string; items: string[] }[] = [];
	let cur: { title: string; lead?: string; items: string[] } | null = null;
	for (const line of md.split(/\r?\n/)) {
		const h = line.match(/^##\s+(.+?)\s*$/);
		if (h) {
			cur = { title: h[1], items: [] };
			sections.push(cur);
			continue;
		}
		if (!cur || /^#\s/.test(line)) continue;
		if (/^-\s+/.test(line)) cur.items.push(line.replace(/^-\s+/, ""));
		else if (line.trim()) cur.lead = cur.lead ? `${cur.lead} ${line.trim()}` : line.trim();
	}
	return sections;
}
const csSections = parseCurrentState(currentStateMd);
const csUpdated = currentStateMd.match(/最后更新\s*([\d-]+)/)?.[1] ?? tasksData.updated;

const claimsByAgent = new Map<string, ClaimCard[]>();
for (const c of claims) {
	const id = ownerToAgentId(c.owner);
	const box = claimsByAgent.get(id) ?? (claimsByAgent.set(id, []), claimsByAgent.get(id)!);
	box.push(c);
}

const mailByPair: Record<string, Msg[]> = {};
for (const m of [...messages].reverse()) {
	const key = `${m.from}→${m.to}`;
	(mailByPair[key] ??= []).push(m);
}

const domains: string[] = [...new Set(exps.map((e) => e.domain))];
const navTabs = [
	{ key: "overview", label: "总览", badge: doingTasks.length },
	{ key: "kanban", label: "任务看板", badge: tasks.length },
	{ key: "decisions", label: "等你拍板", badge: pendingDecisions.length },
	{ key: "mail", label: "信箱", badge: messages.length },
	{ key: "experience", label: "AI 笔记", badge: exps.length },
	{ key: "guide", label: "新手指南", badge: 0 },
];
---

<Layout {title} {description}>
	<meta slot="head" name="robots" content="noindex, nofollow, noarchive" />
	<HeaderTopRow stickyNavbar={true} navbarWidthFull={navbarWidthFull} />
	<main class="mx-auto w-full max-w-7xl px-4 pt-20 pb-16 min-h-screen">
		<!-- ===== Hero ===== -->
		<header class="relative overflow-hidden rounded-3xl mb-6 ring-1 ring-zinc-900/10 dark:ring-white/10">
			<img
				src="/assets/images/agent-board/hero-seraphine.jpg"
				alt=""
				class="absolute inset-0 h-full w-full object-cover"
				loading="eager"
			/>
			<div class="absolute inset-0 bg-gradient-to-r from-zinc-950/85 via-zinc-950/60 to-zinc-950/20"></div>
			<div class="relative px-6 py-10 sm:px-10 sm:py-14">
				<p class="text-[11px] tracking-[0.35em] text-white/60 mb-3">ETERNAL DESIRE · MISSION CONTROL</p>
				<h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white drop-shadow">AI 指挥中心</h1>
				<p class="mt-3 max-w-xl text-sm sm:text-[15px] leading-relaxed text-white/80">
					5 位成员（4 位 AI + 你）在这里协作运营 stulanez.com：
					建图库、做网站功能、互相检查。任务干到哪一步、需要你拍板什么，看这块板就够了。
				</p>
				<div class="mt-5 flex flex-wrap items-center gap-2 text-xs">
					{stateOrder.map((s) => (
						<span class:list={["inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-white/90 ring-1 ring-white/20 backdrop-blur-sm"]}>
							<span class:list={["h-1.5 w-1.5 rounded-full", stateMeta[s].dot]} />
							{stateMeta[s].label} <b class="font-bold">{byState(s).length}</b>
						</span>
					))}
					<span class="ml-auto text-white/50">同步于 {csUpdated}</span>
				</div>
			</div>
		</header>

		<!-- ===== 需要你 ===== -->
		<section id="first-visit" hidden class="mb-6 rounded-2xl border border-violet-300/60 bg-gradient-to-r from-violet-500/10 via-fuchsia-500/5 to-transparent p-5 dark:border-violet-500/30">
			<div class="flex flex-wrap items-center gap-4">
				<span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-violet-500/15 text-xl">👋</span>
				<div class="min-w-0 flex-1">
					<p class="text-sm font-semibold text-zinc-900 dark:text-zinc-50">第一次来？两分钟看懂这块板</p>
					<p class="mt-0.5 text-xs leading-relaxed text-zinc-500 dark:text-zinc-400">
						点上面的「新手指南」看分工和玩法；<b class="text-rose-500">「等你拍板」</b>里有 {pendingDecisions.length} 个问题等你一句话决定（点一下复制，发给任何 AI 对话即可）。
					</p>
				</div>
				<button type="button" id="guide-go" class="rounded-full bg-violet-500 px-4 py-2 text-xs font-semibold text-white shadow hover:bg-violet-400 transition-colors">看指南</button>
				<button type="button" id="guide-dismiss" class="rounded-full border border-zinc-300 px-4 py-2 text-xs text-zinc-500 hover:bg-zinc-100 dark:border-zinc-700 dark:hover:bg-zinc-800 transition-colors">知道了</button>
			</div>
		</section>

		<!-- ===== 导航 ===== -->
		<nav class="sticky top-[64px] z-30 -mx-4 mb-6 bg-zinc-50/85 px-4 py-2 backdrop-blur-md dark:bg-zinc-950/80" aria-label="看板视图">
			<div class="flex flex-wrap items-center gap-1.5">
				{navTabs.map((t, i) => (
					<button
						type="button"
						id={`tabbtn-${t.key}`}
						data-tab={t.key}
						class:list={[
							"inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-medium transition-all",
							i === 0
								? "bg-zinc-900 text-white shadow dark:bg-zinc-100 dark:text-zinc-900"
								: "text-zinc-500 hover:bg-zinc-200/70 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100",
						]}
					>
						{t.label}
						{t.badge > 0 && (
							<span class:list={["rounded-full px-1.5 py-0.5 text-[10px] font-bold",
								i === 0 ? "bg-white/20 dark:bg-zinc-900/15" : t.key === "decisions" ? "bg-rose-500 text-white" : "bg-zinc-300/80 dark:bg-zinc-700"]}>{t.badge}</span>
						)}
					</button>
				))}
			</div>
		</nav>

		<!-- ===== 总览 ===== -->
		<div id="tab-overview">
			<!-- 正在进行 -->
			<section class="mb-8">
				<h2 class="mb-3 flex items-center gap-2 text-lg font-bold text-zinc-900 dark:text-zinc-50">
					<span class="relative flex h-2.5 w-2.5">
						<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-blue-400 opacity-60"></span>
						<span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-blue-500"></span>
					</span>
					现在正在进行
				</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					{doingTasks.map((t) => (
						<article class="group flex overflow-hidden rounded-2xl bg-white ring-1 ring-zinc-200 transition-shadow hover:shadow-lg dark:bg-zinc-900 dark:ring-zinc-800">
							<div class="relative w-28 shrink-0 sm:w-36">
								<img src={coverOf(t.id)} alt="" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
							</div>
							<div class="min-w-0 flex-1 p-4">
								<div class="flex items-center gap-2">
									<span class="rounded-full bg-blue-500/10 px-2 py-0.5 text-[10px] font-bold text-blue-600 ring-1 ring-blue-500/30 dark:text-blue-300">进行中</span>
									<span class="rounded-full bg-zinc-500/10 px-2 py-0.5 text-[10px] text-zinc-500 dark:text-zinc-400">{taskEnrich.categories[catOf(t.id)]?.emoji} {taskEnrich.categories[catOf(t.id)]?.label}</span>
									<button type="button" class="ml-auto text-[11px] text-violet-500 hover:underline" data-task-id={t.id}>详情 →</button>
								</div>
								<h3 class="mt-1.5 text-sm font-bold text-zinc-900 dark:text-zinc-50">{t.title}</h3>
								<p class="mt-1 line-clamp-2 text-xs leading-relaxed text-zinc-500 dark:text-zinc-400">{plainOf(t.id)}</p>
								<p class="mt-2 text-[11px] text-zinc-400 dark:text-zinc-500">{nameOf(ownerAgentId(t.owner))} 负责 · {t.priority}</p>
							</div>
						</article>
					))}
					{doingTasks.length === 0 && (
						<p class="rounded-2xl bg-white p-6 text-sm text-zinc-400 ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-zinc-800">暂无进行中任务</p>
					)}
				</div>
			</section>

			<!-- 团队 -->
			<section class="mb-8">
				<h2 class="mb-3 text-lg font-bold text-zinc-900 dark:text-zinc-50">团队分工</h2>
				<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
					{agents.map((a) => (
						a.id === "user" ? (
							<div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-amber-400/15 to-orange-500/10 p-[1px] ring-1 ring-amber-400/40">
								<div class="h-full rounded-2xl bg-white/60 p-4 backdrop-blur dark:bg-zinc-900/80">
									<div class="flex items-center gap-3">
										<span class="grid h-11 w-11 place-items-center rounded-xl bg-gradient-to-br from-amber-400 to-orange-500 text-lg shadow">👑</span>
										<div class="min-w-0">
											<p class="text-sm font-bold text-zinc-900 dark:text-zinc-50">{a.name} <span class="ml-1 text-[10px] font-medium rounded-full bg-amber-400/20 px-2 py-0.5 text-amber-600 dark:text-amber-300">这就是你</span></p>
											<p class="text-[11px] text-zinc-400">{a.role}</p>
										</div>
									</div>
									<p class="mt-2.5 text-xs leading-relaxed text-zinc-500 dark:text-zinc-400">{plainAgent(a.id)}</p>
								</div>
							</div>
						) : (
							<a
								href={`/lab/agent-board/${a.id}/`}
								data-no-swup
								class="group block rounded-2xl bg-white p-4 ring-1 ring-zinc-200 transition-all hover:shadow-lg hover:ring-zinc-300 dark:bg-zinc-900 dark:ring-zinc-800 dark:hover:ring-zinc-700"
							>
								<div class="flex items-center gap-3">
									<span class="relative">
										<span class="grid h-11 w-11 place-items-center rounded-xl text-base font-bold text-white shadow" style={`background:linear-gradient(135deg,${a.color},color-mix(in srgb,${a.color} 50%,#312e81))`}>{a.name.charAt(0)}</span>
										<span class:list={["absolute -right-0.5 -top-0.5 h-3 w-3 rounded-full ring-2 ring-white dark:ring-zinc-900", a.status === "working" ? "bg-emerald-400" : "bg-zinc-300 dark:bg-zinc-600"]} />
									</span>
									<div class="min-w-0">
										<p class="text-sm font-bold text-zinc-900 dark:text-zinc-50">{a.name}</p>
										<p class="truncate text-[11px] text-zinc-400">{a.model}</p>
									</div>
									<span class:list={["ml-auto shrink-0 rounded-full px-2 py-0.5 text-[10px] font-bold", a.status === "working" ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-300" : "bg-zinc-500/10 text-zinc-400"]}>{a.status === "working" ? "● 工作中" : "空闲"}</span>
								</div>
								<p class="mt-2.5 text-xs leading-relaxed text-zinc-500 dark:text-zinc-400">{plainAgent(a.id)}</p>
								<div class="mt-3 flex items-center gap-3 border-t border-zinc-100 pt-2.5 text-[11px] text-zinc-400 dark:border-zinc-800">
									{a.currentTask && <span class="truncate">📌 {a.currentTask}</span>}
									<span class="ml-auto shrink-0 text-violet-500 opacity-0 transition-opacity group-hover:opacity-100">进入空间 →</span>
								</div>
							</a>
						)
					))}
				</div>
			</section>

			<!-- 全局现状（解析后渲染） -->
			<section class="mb-8 grid grid-cols-1 lg:grid-cols-2 gap-4">
				{csSections.map((sec) => (
					sec.items.length > 0 || sec.lead ? (
						<div class="rounded-2xl bg-white p-5 ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-zinc-800">
							<h3 class="mb-3 flex items-center gap-2 text-sm font-bold text-zinc-900 dark:text-zinc-50">
								<span class="h-4 w-1 rounded-full bg-gradient-to-b from-violet-400 to-fuchsia-400"></span>
								{sec.title}
							</h3>
							{sec.lead && <p class="mb-2 text-xs text-zinc-400 dark:text-zinc-500">{sec.lead}</p>}
							<ul class="space-y-2">
								{sec.items.map((item) => (
									<li class="flex gap-2 text-xs leading-relaxed text-zinc-600 dark:text-zinc-300">
										<span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-zinc-300 dark:bg-zinc-600"></span>
										<span set:html={item.replace(/\*\*(.+?)\*\*/g, "<b class='text-zinc-900 dark:text-zinc-100'>$1</b>")} />
									</li>
								))}
							</ul>
						</div>
					) : null
				))}
			</section>

			<!-- 工程细节 -->
			<details class="group rounded-2xl bg-white ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-zinc-800">
				<summary class="cursor-pointer select-none px-5 py-3.5 text-xs font-medium text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-300">
					⚙️ 工程协作状态（认领卡 / 短锁 / 冲突检查 — AI 用的，老板可以不看）
				</summary>
				<div class="border-t border-zinc-100 px-5 py-4 text-xs dark:border-zinc-800">
					<p class="mb-2 text-zinc-500 dark:text-zinc-400">
						活跃认领 <b class="text-zinc-800 dark:text-zinc-200">{activeClaims.length}</b> ·
						协调冲突 <b class:list={[coordinationIssueCount > 0 ? "text-rose-500" : "text-emerald-500"]}>{coordinationIssueCount}</b> ·
						写入锁 {boardWriteLock ? <b class="text-amber-500">{boardWriteLock.owner}（{boardWriteLock.task}）</b> : <b class="text-emerald-500">空闲</b>}
					</p>
					<ul class="space-y-1 font-mono text-[11px] text-zinc-400">
						{activeClaims.map((c) => <li>🔒 {c.file} — {c.owner} · {c.task}</li>)}
					</ul>
				</div>
			</details>
		</div>

		<!-- ===== 任务看板 ===== -->
		<div id="tab-kanban" hidden>
			<div class="mb-4 flex flex-wrap items-center gap-1.5" id="kanban-filters">
				<button type="button" data-kanban-filter="all" class="rounded-full bg-zinc-900 px-3.5 py-1.5 text-xs font-bold text-white dark:bg-zinc-100 dark:text-zinc-900">全部 {tasks.length}</button>
				{Object.entries(taskEnrich.categories).map(([key, c]) => (
					<button type="button" data-kanban-filter={key} class="rounded-full bg-zinc-500/10 px-3.5 py-1.5 text-xs font-medium text-zinc-600 hover:bg-zinc-500/20 dark:text-zinc-300">{c.emoji} {c.label}</button>
				))}
				{agents.filter((a) => a.id !== "user").map((a) => (
					<button type="button" data-kanban-filter={a.id} class="rounded-full px-3.5 py-1.5 text-xs font-medium ring-1 transition-colors" style={`color:${a.color};--tw-ring-color:${a.color}55`} data-filter-hover>{a.name}</button>
				))}
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-4 items-start">
				{stateOrder.map((s) => {
					const meta = stateMeta[s];
					const colTasks = byState(s);
					return (
						<div class="rounded-2xl bg-zinc-100/60 p-2.5 dark:bg-zinc-900/60">
							<div class="mb-2.5 flex items-center gap-2 px-1.5 pt-1">
								<span class:list={["h-2 w-2 rounded-full", meta.dot]} />
								<h3 class="text-xs font-bold text-zinc-700 dark:text-zinc-200">{meta.label}</h3>
								<span class="rounded-full bg-white px-1.5 text-[10px] font-bold text-zinc-400 dark:bg-zinc-800">{colTasks.length}</span>
								<span class="ml-auto text-[10px] text-zinc-400 dark:text-zinc-500">{meta.hint}</span>
							</div>
							<div class="max-h-[62vh] space-y-2.5 overflow-y-auto pr-0.5 ab-scroll" data-col-body>
								{colTasks.map((t) => (
									<article
										class="group cursor-pointer overflow-hidden rounded-xl bg-white ring-1 ring-zinc-200 transition-all hover:shadow-md hover:ring-violet-300 dark:bg-zinc-900 dark:ring-zinc-800 dark:hover:ring-violet-500/50"
										data-task-id={t.id}
										data-tags={`${catOf(t.id)} ${ownerAgentId(t.owner)}`}
									>
										<div class="relative h-20 overflow-hidden">
											<img src={coverOf(t.id)} alt="" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
											<div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
											<span class="absolute left-2 top-2 rounded-md bg-black/45 px-1.5 py-0.5 font-mono text-[9px] text-white/90 backdrop-blur-sm">{t.id}</span>
