<style>
	.ab-scroll::-webkit-scrollbar {
		width: 5px;
	}
	.ab-scroll::-webkit-scrollbar-thumb {
		border-radius: 9999px;
		background: rgb(161 161 170 / 0.4);
	}
	dialog#task-dialog::backdrop {
		background: rgb(0 0 0 / 0.55);
		backdrop-filter: blur(4px);
	}
</style>

<script>
	const TAB_KEYS = ["overview", "kanban", "decisions", "mail", "experience", "guide"];

	// —— 标签页 ——
	function showTab(key: string) {
		for (const k of TAB_KEYS) {
			document.getElementById(`tab-${k}`)?.toggleAttribute("hidden", k !== key);
			const btn = document.getElementById(`tabbtn-${k}`);
			if (btn) {
				const on = k === key;
				btn.classList.toggle("bg-zinc-900", on);
				btn.classList.toggle("dark:bg-zinc-100", on);
				btn.classList.toggle("text-white", on);
				btn.classList.toggle("dark:text-zinc-900", on);
				btn.classList.toggle("shadow", on);
				btn.classList.toggle("text-zinc-500", !on);
				btn.classList.toggle("dark:text-zinc-400", !on);
				btn.classList.toggle("hover:bg-zinc-200/70", !on);
				btn.classList.toggle("dark:hover:bg-zinc-800", !on);
			}
		}
		history.replaceState(null, "", `#${key}`);
	}
	document.querySelectorAll<HTMLElement>("[data-tab]").forEach((btn) => {
		btn.addEventListener("click", () => {
			showTab(btn.dataset.tab!);
			window.scrollTo({ top: 0, behavior: "smooth" });
		});
	});
	const initial = location.hash.slice(1);
	showTab(TAB_KEYS.includes(initial) ? initial : "overview");

	// —— 首次到访提示 ——
	const fv = document.getElementById("first-visit");
	try {
		if (fv && !localStorage.getItem("ab-guide-seen")) fv.hidden = false;
	} catch {}
	document.getElementById("guide-dismiss")?.addEventListener("click", () => {
		fv!.hidden = true;
		try {
			localStorage.setItem("ab-guide-seen", "1");
		} catch {}
	});
	document.getElementById("guide-go")?.addEventListener("click", () => {
		document.getElementById("tabbtn-guide")?.click();
		fv!.hidden = true;
		try {
			localStorage.setItem("ab-guide-seen", "1");
		} catch {}
	});

	// —— Toast ——
	const toast = document.getElementById("toast")!;
	let toastTimer: ReturnType<typeof setTimeout>;
	function showToast(msg: string) {
		toast.textContent = msg;
		toast.hidden = false;
		clearTimeout(toastTimer);
		toastTimer = setTimeout(() => (toast.hidden = true), 2400);
	}

	// —— 任务详情弹窗 ——
	type JsTask = {
		id: string; title: string; owner: string; ownerName: string; ownerColor: string;
		state: string; stateLabel: string; priority: string; plain: string; brief: string;
		deps: string[]; artifacts: string[]; cover: string; cat: string; catLabel: string;
	};
	const TASKS: Record<string, JsTask> = Object.fromEntries(
		(JSON.parse(document.getElementById("task-data")!.textContent!) as JsTask[]).map((t) => [t.id, t]),
	);
	const dialog = document.getElementById("task-dialog") as HTMLDialogElement;
	const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
	function openTask(id: string) {
		const t = TASKS[id];
		if (!t) return;
		dialog.innerHTML = `
			<div class="relative h-40 w-full overflow-hidden rounded-t-3xl">
				<img src="${t.cover}" alt="" class="h-full w-full object-cover" />
				<div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
				<div class="absolute bottom-3 left-4 right-4 flex items-center gap-2">
					<span class="rounded-md bg-black/50 px-2 py-0.5 font-mono text-[10px] text-white/90">${t.id}</span>
					<span class="rounded-md bg-black/50 px-2 py-0.5 text-[10px] text-white/90">${t.catLabel}</span>
					<span class="rounded-md bg-black/50 px-2 py-0.5 text-[10px] font-bold text-white/90">${t.stateLabel} · ${t.priority}</span>
				</div>
			</div>
			<div class="p-6">
				<h2 class="text-lg font-bold text-zinc-900 dark:text-zinc-50">${esc(t.title)}</h2>
				<div class="mt-1.5 flex items-center gap-2 text-xs text-zinc-400">
					<span class="h-5 w-5 rounded-full text-[9px] font-bold leading-5 text-center text-white" style="background:${t.ownerColor}">${t.ownerName.charAt(0)}</span>
					${t.ownerName} 负责
				</div>
				<p class="mt-4 rounded-xl bg-violet-500/5 px-4 py-3 text-sm leading-relaxed text-zinc-700 ring-1 ring-violet-500/15 dark:text-zinc-200">${esc(t.plain)}</p>
				<details class="mt-3">
					<summary class="cursor-pointer text-[11px] text-zinc-400 hover:text-zinc-600">原始简报（AI 工作用）</summary>
					<p class="mt-2 text-xs leading-relaxed text-zinc-500 dark:text-zinc-400">${esc(t.brief)}</p>
				</details>
				${t.deps.length > 0 ? `<p class="mt-3 text-xs text-amber-600 dark:text-amber-400">⏳ 前置条件：${esc(t.deps.join("；"))}</p>` : ""}
				${t.artifacts.length > 0 ? `<p class="mt-2 break-all text-xs text-zinc-400">📦 产出物：${esc(t.artifacts.join("、"))}</p>` : ""}
				<button type="button" id="dialog-close" class="mt-5 w-full rounded-full bg-zinc-900 py-2.5 text-sm font-bold text-white hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900">关闭</button>
			</div>`;
		dialog.showModal();
		document.getElementById("dialog-close")?.addEventListener("click", () => dialog.close());
	}
	document.querySelectorAll<HTMLElement>("[data-task-id]").forEach((el) => {
		el.addEventListener("click", () => openTask(el.dataset.taskId!));
	});
	dialog.addEventListener("click", (e) => {
		if (e.target === dialog) dialog.close();
	});

	// —— 看板筛选 ——
	const filterBtns = document.querySelectorAll<HTMLElement>("[data-kanban-filter]");
	filterBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			const f = btn.dataset.kanbanFilter!;
			filterBtns.forEach((b) => {
				const on = b === btn;
				b.classList.toggle("bg-zinc-900", on);
				b.classList.toggle("text-white", on);
				b.classList.toggle("dark:bg-zinc-100", on);
				b.classList.toggle("dark:text-zinc-900", on);
				b.classList.toggle("font-bold", on);
			});
			document.querySelectorAll<HTMLElement>("[data-tags]").forEach((card) => {
				const hit = f === "all" || (card.dataset.tags ?? "").split(" ").includes(f);
				card.toggleAttribute("hidden", !hit);
			});
			document.querySelectorAll<HTMLElement>("[data-col-body]").forEach((col) => {
				const anyVisible = col.querySelector("[data-tags]:not([hidden])");
				col.parentElement?.querySelector("[data-col-empty]")?.toggleAttribute("hidden", !!anyVisible);
			});
		});
	});

	// —— 经验库筛选 ——
	document.querySelectorAll<HTMLElement>("[data-exp-filter]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const f = btn.dataset.expFilter!;
			document.querySelectorAll<HTMLElement>("[data-exp-filter]").forEach((b) => {
				const on = b === btn;
				b.classList.toggle("bg-zinc-900", on);
				b.classList.toggle("text-white", on);
				b.classList.toggle("dark:bg-zinc-100", on);
				b.classList.toggle("dark:text-zinc-900", on);
				b.classList.toggle("font-bold", on);
			});
			document.querySelectorAll<HTMLElement>("[data-exp-domain]").forEach((card) => {
				card.toggleAttribute("hidden", !(f === "all" || card.dataset.expDomain === f));
			});
		});
	});

	// —— 复制拍板（clipboard API 失败时走 execCommand 兜底） ——
	function legacyCopy(text: string): void {
		const ta = document.createElement("textarea");
		ta.value = text;
		ta.style.position = "fixed";
		ta.style.opacity = "0";
		document.body.appendChild(ta);
		ta.select();
		const ok = document.execCommand("copy");
		ta.remove();
		if (!ok) throw new Error("copy failed");
	}
	function copyText(text: string): Promise<void> {
		if (navigator.clipboard?.writeText) {
			return navigator.clipboard.writeText(text).catch(() => legacyCopy(text));
		}
		return new Promise((resolve, reject) => {
			try {
				legacyCopy(text);
				resolve();
			} catch (e) {
				reject(e);
			}
		});
	}
	document.querySelectorAll<HTMLElement>("[data-copy]").forEach((btn) => {
		btn.addEventListener("click", () => {
			copyText(btn.dataset.copy!)
				.then(() => showToast("✓ 已复制，粘贴发给任何 AI 即完成拍板"))
				.catch(() => showToast("复制失败，请手动选择文字复制"));
		});
	});
</script>
