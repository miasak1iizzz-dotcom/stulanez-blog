---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { url } from "@/utils/url-utils";
---

<MainGridLayout
	title={i18n(I18nKey.notFound)}
	description={i18n(I18nKey.notFoundDescription)}
>
	<!-- 404：迷失在永恒欲望 -->
	<div class="relative w-full overflow-hidden rounded-(--radius-large) min-h-[28rem]">
		<!-- 渐现光晕 -->
		<div class="nf-glow" aria-hidden="true"></div>

		<div class="card-base relative z-10 w-full px-6 py-14 md:px-12 flex flex-col items-center justify-center text-center">
			<!-- 大号 404 -->
			<div
				class="nf-number select-none font-black leading-none text-[6.5rem] md:text-[9rem] text-(--primary)/12"
				aria-hidden="true"
			>
				404
			</div>

			<!-- 图标 + 标题 -->
			<div class="mt-2 mb-4 flex items-center gap-2.5">
				<div
					class="flex h-9 w-9 items-center justify-center rounded-lg bg-(--primary)/12 text-(--primary)"
				>
					<Icon name="material-symbols:signpost-rounded" class="text-[1.4rem]" />
				</div>
				<h1 class="text-2xl md:text-3xl font-bold text-90">
					{i18n(I18nKey.notFoundTitle)}
				</h1>
			</div>

			<p class="text-base text-75 mb-8 max-w-md leading-relaxed">
				{i18n(I18nKey.notFoundDescription)}
			</p>

			<!-- 快捷导航 -->
			<div class="flex flex-wrap items-center justify-center gap-2.5">
				{
					[
						{
							label: i18n(I18nKey.backToHome),
							href: url("/"),
							icon: "material-symbols:home-rounded",
							primary: true,
						},
						{
							label: i18n(I18nKey.archive),
							href: url("/archive/"),
							icon: "material-symbols:archive-rounded",
						},
						{
							label: i18n(I18nKey.friends),
							href: url("/friends/"),
							icon: "material-symbols:group-rounded",
						},
						{
							label: i18n(I18nKey.booknav),
							href: url("/booknav/"),
							icon: "material-symbols:bookmarks-rounded",
						},
					].map((item) => (
						<a
							href={item.href}
							class:list={[
								"nf-action inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-medium transition-all duration-200",
								item.primary
									? "bg-(--primary) text-white hover:bg-(--btn-content)"
									: "bg-(--btn-plain-bg) text-90 hover:text-(--primary) hover:bg-(--btn-plain-bg-hover)",
							]}
						>
							<Icon name={item.icon} class="text-[1.15rem]" />
							<span>{item.label}</span>
						</a>
					))
				}
			</div>

			<!-- 装饰 -->
			<div class="nf-decor nf-decor-a" aria-hidden="true">
				<Icon name="material-symbols:explore-rounded" class="text-5xl" />
			</div>
			<div class="nf-decor nf-decor-b" aria-hidden="true">
				<Icon name="material-symbols:error-outline" class="text-4xl" />
			</div>
		</div>
	</div>
</MainGridLayout>

<style>
	.nf-glow {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(
			circle at 50% 0%,
			color-mix(in oklch, var(--primary) 16%, transparent),
			transparent 62%
		);
	}
	.nf-number {
		letter-spacing: -0.04em;
	}

	.nf-action {
		transform: translateY(0);
	}
	.nf-action:hover {
		transform: translateY(-2px);
	}

	.nf-decor {
		position: absolute;
		color: var(--primary);
		opacity: 0.1;
		pointer-events: none;
	}
	.nf-decor-a {
		top: 1.25rem;
		left: 1.5rem;
		animation: nf-float 5s ease-in-out infinite;
	}
	.nf-decor-b {
		bottom: 1.25rem;
		right: 1.5rem;
		animation: nf-float 6s ease-in-out infinite reverse;
	}
	@keyframes nf-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-10px);
		}
	}

	.card-base {
		animation: nf-fade-up 0.55s ease-out;
	}
	@keyframes nf-fade-up {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
