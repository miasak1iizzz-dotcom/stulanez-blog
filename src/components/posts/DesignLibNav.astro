      <a class="site-nav__btn site-nav__btn--live" href={s.live} target="_blank" rel="noopener">原站 ↗</a>
    </div>
  ))}
</div>

<style>
  .site-nav {
    margin: 1.75rem 0 1.25rem;
    border: 1px solid var(--line-divider, rgba(128, 128, 128, 0.22));
    border-radius: 0.85rem;
    overflow: hidden;
    font-size: 0.86rem;
  }
  .site-nav__head,
  .site-nav__row {
    display: grid;
    grid-template-columns: 2.2rem 1.2fr 1.5fr 6.4rem 5rem;
    gap: 0.6rem;
    align-items: center;
    padding: 0.6rem 0.9rem;
  }
  .site-nav__head {
    font-weight: 600;
    letter-spacing: 0.04em;
    opacity: 0.65;
    font-size: 0.76rem;
    text-transform: uppercase;
    border-bottom: 1px solid var(--line-divider, rgba(128, 128, 128, 0.22));
    background: rgba(128, 128, 128, 0.06);
  }
  .site-nav__row + .site-nav__row {
    border-top: 1px solid var(--line-divider, rgba(128, 128, 128, 0.12));
  }
  .site-nav__row:hover { background: rgba(128, 128, 128, 0.06); }
  .site-nav__n {
    font-variant-numeric: tabular-nums;
    opacity: 0.55;
    font-size: 0.78rem;
  }
  .site-nav__name { font-weight: 600; }
  .site-nav__stack {
    opacity: 0.62;
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ta-c { text-align: center; }
  .site-nav__btn {
    display: inline-block;
    text-align: center;
    padding: 0.28rem 0.5rem;
    border-radius: 0.45rem;
    font-size: 0.76rem;
    font-weight: 600;
    text-decoration: none !important;
    border: 1px solid transparent;
    transition: transform 0.12s ease, opacity 0.12s ease;
    white-space: nowrap;
  }
  .site-nav__btn:hover { transform: translateY(-1px); opacity: 0.85; }
  .site-nav__btn--local {
    background: color-mix(in srgb, var(--primary, #3b82f6) 16%, transparent);
    border-color: color-mix(in srgb, var(--primary, #3b82f6) 42%, transparent);
    color: var(--primary, #3b82f6);
  }
  .site-nav__btn--live {
    background: rgba(128, 128, 128, 0.13);
    border-color: rgba(128, 128, 128, 0.3);
  }
  @media (max-width: 720px) {
    .site-nav__head { display: none; }
    .site-nav__row {
      grid-template-columns: 2rem 1fr;
      grid-template-areas: "n name" ". stack" ". btns";
      gap: 0.35rem 0.6rem;
    }
    .site-nav__n { grid-area: n; }
    .site-nav__name { grid-area: name; }
    .site-nav__stack { grid-area: stack; white-space: normal; }
    .site-nav__btn--local { grid-area: btns; width: fit-content; margin-top: 0.3rem; }
    .site-nav__btn--live { grid-area: btns; width: fit-content; margin-top: 0.3rem; margin-left: 0.5rem; }
  }
