---
import { getGalleryGridSrc } from "@/utils/gallery-utils";
import { getLqipProps } from "@/utils/lqip-utils";

interface Props {
	src: string;
	albumId: string;
	gridSrc?: string;
	lqipSrc?: string;
	alt?: string;
}

const { src, albumId, alt = "", lqipSrc } = Astro.props;

// LQIP 渐变占位
const lqipProps = getLqipProps(lqipSrc || src, undefined, true);
const gridSrc = Astro.props.gridSrc || getGalleryGridSrc(src);
---

<div class="gallery-photo-card break-inside-avoid mb-3">
  <div
    data-fancybox={`gallery-${albumId}`}
    data-src={src}
    data-type="image"
    class="block rounded-xl overflow-hidden relative group cursor-pointer"
  >
    <div class="lqip-placeholder absolute inset-0 pointer-events-none" style={lqipProps.style} aria-hidden="true"></div>
    <img
      src={gridSrc}
      alt={alt}
      width="480"
      height="640"
      sizes="(max-width: 640px) 50vw, 240px"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
      class="w-full h-auto object-cover transition-transform duration-500 ease-out group-hover:scale-105"
    />
  </div>
</div>
