---
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";
import { Icon } from "astro-icon/components";
import ci from "ci-info";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { licenseConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { detectBuildPlatform } from "@/utils/build-platform";
import { formatDateI18nWithTime } from "@/utils/date-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;

// ---- 构建时收集版本和环境信息 ----

// 博客版本（从 package.json 读取）
let blogVersion = "unknown";
try {
	const pkg = JSON.parse(
		readFileSync(new URL("../../../package.json", import.meta.url), "utf-8"),
	);
	blogVersion = pkg.version || "Firefly unknown";
} catch {}

// Astro 版本（从已安装的 astro 包读取）
let astroVersion = "unknown";
try {
	const require = createRequire(import.meta.url);
	const astroPkg = require("astro/package.json");
	astroVersion = astroPkg.version || "unknown";
} catch {}

// Node 版本
const nodeVersion = process.version;

// pnpm 版本（从 npm_config_user_agent 解析）
let pnpmVersion = "unknown";
const userAgent = process.env.npm_config_user_agent || "";
const pnpmMatch = userAgent.match(/pnpm\/([\d.]+)/);
if (pnpmMatch) {
	pnpmVersion = `v${pnpmMatch[1]}`;
}

// 构建时间
const buildTime = formatDateI18nWithTime(new Date());

// 构建平台检测（使用 ci-info 自动识别 CI 环境）
const unknownBuildPlatform =
	widgetConfig?.specificConfig?.siteInfo?.unknownBuildPlatform || "Unknown CI";
const buildPlatform = detectBuildPlatform({
	env: process.env,
	isCI: ci.isCI,
	ciName: ci.name,
	isDev: import.meta.env.DEV,
	unknownBuildPlatform,
});

// 系统信息（平台 + 架构）
const platformMap: Record<string, string> = {
	win32: "Windows",
	darwin: "macOS",
	linux: "Linux",
	freebsd: "FreeBSD",
};
const archMap: Record<string, string> = {
	x64: "x86_64",
	arm64: "ARM64",
	arm: "ARM",
	ia32: "x86",
};
const osName = platformMap[process.platform] || process.platform;
const archName = archMap[process.arch] || process.arch;
const systemInfo = `${osName} / ${archName}`;

// 站点域名（去掉协议前缀）
const siteDomain = siteConfig.site_url
	? siteConfig.site_url.replace(/^https?:\/\//, "").replace(/\/$/, "")
	: "unknown";

// 文章许可
const licenseName = licenseConfig.enable ? licenseConfig.name : "None";

// ---- 组装展示数据 ----
// 始终显示的项目（列表）
const mainItems = [
	{
		icon: "material-symbols:cloud-outline",
		label: i18n(I18nKey.siteInfoBuildPlatform),
		value: buildPlatform,
	},
	{
		icon: "mdi:clover",
		label: i18n(I18nKey.siteInfoBlogVersion),
		value: `Firefly v${blogVersion}`,
		href: "https://github.com/CuteLeaf/Firefly",
	},
	{
		icon: "material-symbols:copyright-outline",
		label: i18n(I18nKey.siteInfoLicense),
		value: licenseName,
	},
];

// 可折叠的项目（格子布局）
// fullWidth: true 表示独占一行
const detailItems: {
	icon: string;
	label: string;
	value: string;
	fullWidth?: boolean;
}[] = [
	{
		icon: "material-symbols:language",
		label: i18n(I18nKey.siteInfoDomain),
		value: siteDomain,
		fullWidth: true,
	},
	{
		icon: "mdi:clover",
		label: "Firefly",
		value: `v${blogVersion}`,
	},
	{
		icon: "material-symbols:rocket-launch-outline",
		label: i18n(I18nKey.siteInfoAstroVersion),
		value: `v${astroVersion}`,
	},
	{
		icon: "fa7-brands:node-js",
		label: i18n(I18nKey.siteInfoNodeVersion),
		value: nodeVersion,
	},
	{
		icon: "simple-icons:pnpm",
		label: i18n(I18nKey.siteInfoPnpmVersion),
		value: pnpmVersion,
	},
	{
		icon: "material-symbols:build-outline",
		label: i18n(I18nKey.siteInfoBuildTime),
		value: buildTime,
		fullWidth: true,
	},
	{
		icon: "material-symbols:computer-outline",
		label: i18n(I18nKey.siteInfoSystem),
		value: systemInfo,
		fullWidth: true,
	},
];
---

<WidgetLayout
  name={i18n(I18nKey.siteInfo)}
  showTitle={showTitle}
  id="site-info"
  class={className}
  style={style}
>
	<span slot="title-icon" class="info-status-chip"><i></i>ONLINE</span>
	<div class="site-info-shell">
    {/* 始终显示的项目（列表卡片） */}
		<div class="site-info-primary">
      {
        mainItems.map((item: { icon: string; label: string; value: string; href?: string }) => (
			<div class="site-info-row">
				<div class="site-info-key">
					<div class="site-info-icon">
                <Icon name={item.icon} />
              </div>
					<span>
                {item.label}
              </span>
            </div>
            {item.href ? (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
					class="site-info-value"
                title={item.value}
              >
                {item.value}
              </a>
            ) : (
              <span
					class="site-info-value"
                title={item.value}
              >
                {item.value}
              </span>
            )}
          </div>
        ))
      }
    </div>

    {/* 可折叠区域（格子布局） */}
    <site-info-collapse
      data-expand-text={i18n(I18nKey.siteInfoExpand)}
      data-collapse-text={i18n(I18nKey.siteInfoCollapse)}
    >
      <div class="site-info-detail overflow-hidden collapsed">
				<div class="site-info-grid">
          {
            detailItems.map(
              (item: { icon: string; label: string; value: string; fullWidth?: boolean }) => (
                <div class:list={[
							"site-info-detail-tile",
							{ "site-info-detail-wide": item.fullWidth }
                ]}>
							<div class="site-info-detail-icon">
                    <Icon name={item.icon} />
                  </div>
							<span class="site-info-detail-label">
                    {item.label}
                  </span>
                  <span
								class="site-info-detail-value"
                    title={item.value}
                  >
                    {item.value}
                  </span>
                </div>
              ),
            )
          }
        </div>
      </div>
      <button
				class="site-info-toggle-btn"
      >
        <Icon
          name="material-symbols:keyboard-arrow-down-rounded"
          class="site-info-toggle-icon w-6 h-6 transition-transform duration-200"
        />
        <span class="site-info-toggle-text"></span>
      </button>
    </site-info-collapse>
  </div>
</WidgetLayout>

<style>
	:global(widget-layout[data-id="site-info"]) {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(circle at 106% 106%, color-mix(in srgb, var(--primary) 12%, transparent), transparent 45%),
			linear-gradient(150deg, color-mix(in srgb, var(--card-bg) 96%, var(--primary) 4%), var(--card-bg));
	}

	.info-status-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-right: 1rem;
		color: color-mix(in srgb, var(--primary) 76%, #71717a);
		font-size: 0.55rem;
		font-weight: 800;
		letter-spacing: 0.1em;
	}

	.info-status-chip i {
		width: 0.38rem;
		height: 0.38rem;
		border-radius: 50%;
		background: #51c995;
		box-shadow: 0 0 0 0.2rem rgb(81 201 149 / 12%);
	}

	.site-info-shell,
	.site-info-primary {
		display: flex;
		flex-direction: column;
		gap: 0.48rem;
	}

	.site-info-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		min-height: 2.55rem;
		padding: 0.42rem 0.55rem;
		border: 1px solid color-mix(in srgb, var(--primary) 7%, transparent);
		border-radius: 0.78rem;
		background: color-mix(in srgb, var(--card-bg) 76%, transparent);
		box-shadow: inset 0 1px rgb(255 255 255 / 11%);
		transition: 0.2s ease;
	}

	.site-info-row:hover {
		border-color: color-mix(in srgb, var(--primary) 17%, transparent);
		transform: translateX(1px);
	}

	.site-info-key {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		color: rgb(82 82 91);
		font-size: 0.7rem;
		font-weight: 650;
	}

	:global(.dark) .site-info-key {
		color: rgb(212 212 216);
	}

	.site-info-icon {
		display: grid;
		place-items: center;
		width: 1.55rem;
		height: 1.55rem;
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--primary) 9%, transparent);
		color: var(--primary);
		font-size: 0.95rem;
	}

	.site-info-value {
		overflow: hidden;
		max-width: 54%;
		color: rgb(39 39 42);
		font-size: 0.66rem;
		font-weight: 800;
		text-align: right;
		text-decoration: none;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	:global(.dark) .site-info-value {
		color: rgb(244 244 245);
	}

	a.site-info-value:hover {
		color: var(--primary);
	}

	site-info-collapse .collapsed {
		height: 0;
	}

	.site-info-detail {
		transition: height 0.28s ease;
	}

	.site-info-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.45rem;
		padding-top: 0.48rem;
	}

	.site-info-detail-tile {
		display: flex;
		align-items: center;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
		padding: 0.55rem 0.35rem;
		border: 1px solid color-mix(in srgb, var(--primary) 7%, transparent);
		border-radius: 0.72rem;
		background: color-mix(in srgb, var(--primary) 4%, var(--card-bg));
	}

	.site-info-detail-wide {
		grid-column: span 2;
	}

	.site-info-detail-icon {
		color: var(--primary);
		font-size: 1rem;
	}

	.site-info-detail-label {
		color: rgb(113 113 122);
		font-size: 0.58rem;
	}

	.site-info-detail-value {
		overflow: hidden;
		width: 100%;
		color: rgb(63 63 70);
		font-size: 0.65rem;
		font-weight: 750;
		text-align: center;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	:global(.dark) .site-info-detail-label {
		color: rgb(161 161 170);
	}

	:global(.dark) .site-info-detail-value {
		color: rgb(228 228 231);
	}

	.site-info-toggle-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		width: 100%;
		height: 2rem;
		margin-top: 0.2rem;
		border: 0;
		border-radius: 0.65rem;
		background: transparent;
		color: color-mix(in srgb, var(--primary) 76%, #71717a);
		font-size: 0.67rem;
		font-weight: 700;
		cursor: pointer;
		transition: 0.2s ease;
	}

	.site-info-toggle-btn:hover {
		background: color-mix(in srgb, var(--primary) 7%, transparent);
	}
</style>

<script>
  class SiteInfoCollapse extends HTMLElement {
    constructor() {
      super();
      const btn = this.querySelector(
        ".site-info-toggle-btn",
      ) as HTMLButtonElement | null;
      const detail = this.querySelector(".site-info-detail");
      const textEl = this.querySelector(".site-info-toggle-text");
      const iconEl = this.querySelector(".site-info-toggle-icon");
      if (!btn || !detail || !textEl) return;

      const expandText = this.dataset.expandText || "展开构建信息";
      const collapseText = this.dataset.collapseText || "收起构建信息";

      // 初始状态已在 HTML 中通过 class="collapsed" 设定，JS 只需同步文字
      let expanded = false;
      textEl.textContent = expandText;

      btn.addEventListener("click", () => {
        expanded = !expanded;
        detail.classList.toggle("collapsed", !expanded);
        textEl.textContent = expanded ? collapseText : expandText;
        iconEl?.classList.toggle("rotate-180", expanded);
      });
    }
  }

  if (!customElements.get("site-info-collapse")) {
    customElements.define("site-info-collapse", SiteInfoCollapse);
  }
</script>
