---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { atmosphereConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { pickDailyQuote } from "@/utils/atmosphere-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
const quote = pickDailyQuote(
	atmosphereConfig.hitokoto.quotes,
	new Date(),
	siteConfig.timezone || "Asia/Shanghai",
);
---

{
	quote && (
		<WidgetLayout
			name={i18n(I18nKey.hitokoto)}
			showTitle={showTitle}
			id="hitokoto"
			class={className}
			style={style}
		>
			<span slot="title-icon" class="quote-title-icon">
				<Icon name="material-symbols:format-quote-rounded" />
				DAILY
			</span>
			<div class="quote-card-body">
				<div class="quote-mark" aria-hidden="true">“</div>
				<blockquote>{quote.text}</blockquote>
				<div class="quote-signature">
					<span></span>
					{quote.author ? <p>{quote.author}</p> : <p>今日摘录</p>}
				</div>
			</div>
		</WidgetLayout>
	)
}

<style>
	:global(widget-layout[data-id="hitokoto"]) {
		position: relative;
		overflow: hidden;
		background:
			linear-gradient(135deg, color-mix(in srgb, var(--card-bg) 96%, var(--primary) 4%), var(--card-bg)),
			var(--card-bg);
	}

	:global(widget-layout[data-id="hitokoto"]::before) {
		position: absolute;
		inset: auto -2.2rem -3.8rem auto;
		width: 9rem;
		height: 9rem;
		border-radius: 45% 55% 62% 38%;
		background: color-mix(in srgb, var(--primary) 7%, transparent);
		content: "";
		transform: rotate(-18deg);
		pointer-events: none;
	}

	.quote-title-icon {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		margin-right: 1rem;
		color: color-mix(in srgb, var(--primary) 78%, #716975);
		font-size: 0.58rem;
		font-weight: 800;
		letter-spacing: 0.13em;
	}

	.quote-title-icon :global(svg) {
		font-size: 1rem;
	}

	.quote-card-body {
		position: relative;
		z-index: 1;
		padding: 0.25rem 0 0.1rem 0.2rem;
	}

	.quote-mark {
		position: absolute;
		top: -1.1rem;
		left: -0.2rem;
		color: color-mix(in srgb, var(--primary) 20%, transparent);
		font-family: Georgia, "Songti SC", serif;
		font-size: 5.4rem;
		line-height: 1;
		pointer-events: none;
	}

	.quote-card-body blockquote {
		position: relative;
		margin: 0;
		padding: 0.55rem 0.35rem 0.5rem 0.9rem;
		color: rgb(63 63 70);
		font-family: Georgia, "Songti SC", serif;
		font-size: 0.98rem;
		font-weight: 600;
		line-height: 1.85;
		letter-spacing: 0.025em;
	}

	:global(.dark) .quote-card-body blockquote {
		color: rgb(228 228 231);
	}

	.quote-signature {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.55rem;
		margin-top: 0.15rem;
	}

	.quote-signature span {
		width: 2rem;
		height: 1px;
		background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--primary) 58%, transparent));
	}

	.quote-signature p {
		margin: 0;
		color: rgb(113 113 122);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
	}

	:global(.dark) .quote-signature p {
		color: rgb(161 161 170);
	}
</style>
