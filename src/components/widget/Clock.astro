---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
const timeZone = siteConfig.timezone || "Asia/Shanghai";
const locale =
	siteConfig.lang === "zh_CN"
		? "zh-CN"
		: siteConfig.lang === "zh_TW"
			? "zh-TW"
			: siteConfig.lang === "ja"
				? "ja-JP"
				: siteConfig.lang === "ko"
					? "ko-KR"
					: siteConfig.lang === "ru"
						? "ru-RU"
						: "en-US";
const greetings = {
	morning: i18n(I18nKey.greetingMorning),
	noon: i18n(I18nKey.greetingNoon),
	afternoon: i18n(I18nKey.greetingAfternoon),
	evening: i18n(I18nKey.greetingEvening),
	night: i18n(I18nKey.greetingNight),
};
---

<WidgetLayout
	name={i18n(I18nKey.clock)}
	showTitle={showTitle}
	id="sidebar-clock"
	class={className}
	style={style}
>
	<span slot="title-icon" class="clock-zone-chip">
		<Icon name="material-symbols:location-on-outline-rounded" />
		UTC+8
	</span>
	<div class="clock-stage" data-clock-root>
		<p
			class="clock-greeting"
			data-clock-greeting
		>
			{i18n(I18nKey.clockFetching)}
		</p>
		<p
			class="clock-time"
			data-clock-time
		>
			--:--:--
		</p>
		<div class="clock-meta">
			<p data-clock-weekday>---</p>
			<span></span>
			<p data-clock-date>--/--</p>
		</div>
		<div class="clock-orbit" aria-hidden="true"><span></span></div>
	</div>
</WidgetLayout>

<script is:inline define:vars={{ timeZone, locale, greetings }}>
	function getClockPeriod(hour) {
		if (hour >= 5 && hour < 11) return "morning";
		if (hour >= 11 && hour < 14) return "noon";
		if (hour >= 14 && hour < 18) return "afternoon";
		if (hour >= 18 && hour < 23) return "evening";
		return "night";
	}

	function readZonedParts(date) {
		const parts = new Intl.DateTimeFormat("en-US", {
			timeZone,
			year: "numeric",
			month: "2-digit",
			day: "2-digit",
			hour: "2-digit",
			minute: "2-digit",
			second: "2-digit",
			hourCycle: "h23",
		}).formatToParts(date);
		const get = (type) => parts.find((part) => part.type === type)?.value || "";
		return {
			hour: Number(get("hour")),
			minute: Number(get("minute")),
			second: Number(get("second")),
			month: Number(get("month")),
			day: Number(get("day")),
		};
	}

	function pad(value) {
		return String(value).padStart(2, "0");
	}

	function renderClock() {
		const roots = document.querySelectorAll("[data-clock-root]");
		if (!roots.length) return;
		const now = new Date();
		const parts = readZonedParts(now);
		const time = `${pad(parts.hour)}:${pad(parts.minute)}:${pad(parts.second)}`;
		const date = `${pad(parts.month)}/${pad(parts.day)}`;
		const greeting = greetings[getClockPeriod(parts.hour)] || "";
		const weekday = new Intl.DateTimeFormat(locale, {
			timeZone,
			weekday: "long",
		}).format(now);
		roots.forEach((root) => {
			const greetingEl = root.querySelector("[data-clock-greeting]");
			const timeEl = root.querySelector("[data-clock-time]");
			const weekdayEl = root.querySelector("[data-clock-weekday]");
			const dateEl = root.querySelector("[data-clock-date]");
			if (greetingEl) greetingEl.textContent = greeting;
			if (timeEl) timeEl.textContent = time;
			if (weekdayEl) weekdayEl.textContent = weekday;
			if (dateEl) dateEl.textContent = date;
		});
	}

	function startClock() {
		renderClock();
		if (window.__stulanezClockTimer) {
			clearInterval(window.__stulanezClockTimer);
		}
		window.__stulanezClockTimer = setInterval(renderClock, 1000);
	}

	startClock();
	if (!window.__stulanezClockInit) {
		window.__stulanezClockInit = true;
		document.addEventListener("swup:contentReplaced", () => {
			setTimeout(startClock, 50);
		});
		document.addEventListener("visibilitychange", () => {
			if (!document.hidden) renderClock();
		});
	}
</script>

<style>
	:global(widget-layout[data-id="sidebar-clock"]) {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(circle at 88% 18%, color-mix(in srgb, var(--primary) 18%, transparent), transparent 42%),
			linear-gradient(150deg, color-mix(in srgb, var(--card-bg) 94%, var(--primary) 6%), var(--card-bg));
	}

	.clock-zone-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		margin-right: 1rem;
		color: color-mix(in srgb, var(--primary) 76%, #71717a);
		font-size: 0.57rem;
		font-weight: 800;
		letter-spacing: 0.08em;
	}

	.clock-zone-chip :global(svg) {
		font-size: 0.9rem;
	}

	.clock-stage {
		position: relative;
		display: flex;
		align-items: center;
		flex-direction: column;
		padding: 0.35rem 0 0.2rem;
		text-align: center;
	}

	.clock-greeting {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		padding: 0.28rem 0.65rem;
		border: 1px solid color-mix(in srgb, var(--primary) 16%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--primary) 8%, var(--card-bg));
		color: color-mix(in srgb, var(--primary) 78%, #65606a);
		font-size: 0.66rem;
		font-weight: 700;
	}

	.clock-greeting::before {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: var(--primary);
		box-shadow: 0 0 0 0.22rem color-mix(in srgb, var(--primary) 12%, transparent);
		content: "";
	}

	.clock-time {
		position: relative;
		z-index: 1;
		margin: 0.6rem 0 0;
		color: rgb(24 24 27);
		font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
		font-size: clamp(1.78rem, 2.8vw, 2.15rem);
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.055em;
		line-height: 1.1;
		text-shadow: 0 0.45rem 1.4rem color-mix(in srgb, var(--primary) 14%, transparent);
	}

	:global(.dark) .clock-time {
		color: rgb(250 250 250);
	}

	.clock-meta {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-top: 0.6rem;
		padding: 0.4rem 0.8rem;
		border-radius: 0.7rem;
		background: color-mix(in srgb, var(--card-bg) 72%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--primary) 8%, transparent);
	}

	.clock-meta p {
		margin: 0;
		color: rgb(113 113 122);
		font-size: 0.7rem;
		font-weight: 650;
		font-variant-numeric: tabular-nums;
	}

	:global(.dark) .clock-meta p {
		color: rgb(161 161 170);
	}

	.clock-meta span {
		width: 0.22rem;
		height: 0.22rem;
		border-radius: 50%;
		background: color-mix(in srgb, var(--primary) 58%, transparent);
	}

	.clock-orbit {
		position: absolute;
		top: -3.8rem;
		right: -3.6rem;
		width: 8.5rem;
		height: 8.5rem;
		border: 1px solid color-mix(in srgb, var(--primary) 10%, transparent);
		border-radius: 50%;
		pointer-events: none;
	}

	.clock-orbit span {
		position: absolute;
		bottom: 1.1rem;
		left: 0.35rem;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: color-mix(in srgb, var(--primary) 35%, transparent);
		box-shadow: 0 0 0.8rem color-mix(in srgb, var(--primary) 30%, transparent);
	}
</style>
