---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { announcementConfig } from "@/config/announcementConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

const config = announcementConfig;

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}
const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;
---

<!-- 组件显示现在由sidebarLayoutConfig统一控制，无需检查config.enable -->
<WidgetLayout
  name={config.title || i18n(I18nKey.announcement)}
  showTitle={showTitle}
  id="announcement"
  class={className}
  style={style}
>
	<span slot="title-icon" class="notice-title-chip">
		<span></span>
		NOTICE
	</span>
	<div class="notice-body">
		<div class="notice-kicker">
			<Icon name="material-symbols:campaign-outline-rounded" />
			<span>FROM STULANEZ</span>
		</div>
		<p>{config.content}</p>

		<div class="notice-actions">
			{
				config.link && config.link.enable !== false && (
					<a
						href={config.link.url}
						target={config.link.external ? "_blank" : "_self"}
						rel={config.link.external ? "noopener noreferrer" : undefined}
					>
						<span>{config.link.text}</span>
						<Icon name="material-symbols:arrow-right-alt-rounded" />
					</a>
				)
			}

			{
				config.closable && (
					<button
						onclick="this.closest('widget-layout').style.display='none'"
						aria-label={i18n(I18nKey.announcementClose)}
					>
						<Icon name="fa7-solid:xmark" />
					</button>
				)
			}
		</div>
	</div>
</WidgetLayout>

<style>
	:global(widget-layout[data-id="announcement"]) {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(circle at 105% -5%, color-mix(in srgb, var(--primary) 22%, transparent), transparent 44%),
			linear-gradient(145deg, color-mix(in srgb, var(--card-bg) 94%, var(--primary) 6%), var(--card-bg));
	}

	:global(widget-layout[data-id="announcement"]::after) {
		position: absolute;
		right: -2rem;
		bottom: -3rem;
		width: 8rem;
		height: 8rem;
		border: 1px solid color-mix(in srgb, var(--primary) 16%, transparent);
		border-radius: 50%;
		box-shadow:
			0 0 0 1.2rem color-mix(in srgb, var(--primary) 5%, transparent),
			0 0 0 2.4rem color-mix(in srgb, var(--primary) 3%, transparent);
		content: "";
		pointer-events: none;
	}

	.notice-title-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-right: 1rem;
		color: color-mix(in srgb, var(--primary) 80%, #6b6570);
		font-size: 0.58rem;
		font-weight: 800;
		letter-spacing: 0.12em;
	}

	.notice-title-chip span {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 50%;
		background: var(--primary);
		box-shadow: 0 0 0 0.25rem color-mix(in srgb, var(--primary) 12%, transparent);
	}

	.notice-body {
		position: relative;
		z-index: 1;
	}

	.notice-kicker {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: 0.65rem;
		color: var(--primary);
		font-size: 0.64rem;
		font-weight: 800;
		letter-spacing: 0.12em;
	}

	.notice-kicker :global(svg) {
		font-size: 1rem;
	}

	.notice-body p {
		margin: 0;
		color: rgb(82 82 91);
		font-size: 0.9rem;
		line-height: 1.75;
	}

	:global(.dark) .notice-body p {
		color: rgb(212 212 216);
	}

	.notice-actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 0.9rem;
	}

	.notice-actions a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 2rem;
		padding: 0 0.8rem;
		border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--primary) 10%, transparent);
		color: color-mix(in srgb, var(--primary) 82%, #514c54);
		font-size: 0.75rem;
		font-weight: 700;
		text-decoration: none;
		transition: 0.2s ease;
	}

	.notice-actions a:hover {
		gap: 0.55rem;
		background: color-mix(in srgb, var(--primary) 16%, transparent);
	}

	.notice-actions a :global(svg) {
		font-size: 1.05rem;
	}

	.notice-actions button {
		display: grid;
		place-items: center;
		width: 1.9rem;
		height: 1.9rem;
		margin-left: auto;
		border: 1px solid color-mix(in srgb, var(--primary) 12%, transparent);
		border-radius: 50%;
		background: color-mix(in srgb, var(--card-bg) 78%, transparent);
		color: rgb(161 161 170);
		cursor: pointer;
		transition: 0.2s ease;
	}

	.notice-actions button:hover {
		border-color: color-mix(in srgb, #ef6262 35%, transparent);
		color: #e65555;
		transform: rotate(8deg);
	}
</style>
