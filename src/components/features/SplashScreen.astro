---
import { atmosphereConfig, siteConfig } from "@/config";
import { url } from "@/utils/url-utils";
import "@/styles/splash.css";

const splash = atmosphereConfig.splash;
const title = siteConfig.title;
const catalog = {
	portraits: Object.fromEntries(
		splash.portraits.map((item) => [item.id, url(item.image)]),
	),
	uppers: Object.fromEntries(
		splash.upperBanners.map((item) => [item.id, url(item.image)]),
	),
	lowers: Object.fromEntries(
		splash.lowerBanners.map((item) => [item.id, url(item.image)]),
	),
	defaults: {
		portrait: splash.defaultPortrait,
		upper: splash.defaultUpper,
		lower: splash.defaultLower,
	},
};
---

{
	splash.enable && (
		<div
			id="splash-screen"
			class="splash-screen"
			hidden
			data-duration={splash.durationMs}
			aria-hidden="true"
		>
			<img class="splash-upper" data-splash-upper alt="" />
			<div class="splash-hero">
				<img class="splash-character" data-splash-character alt="" />
				<p class="splash-title">{title}</p>
			</div>
			<img class="splash-lower" data-splash-lower alt="" />
			<script type="application/json" id="splash-catalog" set:html={JSON.stringify(catalog)} />
		</div>
	)
}

{
	splash.enable && (
		<script is:inline data-swup-ignore-script>
			(function initSplashScreen() {
				var root = document.getElementById("splash-screen");
				if (!root) return;

				var SESSION_KEY = "stulanez.splash.played";
				var duration = parseInt(root.getAttribute("data-duration") || "2200", 10);
				var catalogNode = document.getElementById("splash-catalog");
				var catalog = { portraits: {}, uppers: {}, lowers: {}, defaults: {} };
				try {
					catalog = JSON.parse(catalogNode && catalogNode.textContent ? catalogNode.textContent : "{}");
				} catch (e) {}
				var hideTimer = 0;
				var playing = false;
				var upperEl = root.querySelector("[data-splash-upper]");
				var characterEl = root.querySelector("[data-splash-character]");
				var lowerEl = root.querySelector("[data-splash-lower]");

				function reducedMotion() {
					return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				}

				function storedEnabled() {
					try {
						var raw = localStorage.getItem("splashEnabled");
						if (raw === null) return true;
						return raw === "true";
					} catch (e) {
						return true;
					}
				}

				function storedOr(key, fallback) {
					try {
						var raw = localStorage.getItem(key);
						if (raw) return raw;
					} catch (e) {}
					return fallback;
				}

				function applyArt(portrait, upper, lower) {
					var portraitSrc = catalog.portraits[portrait] || catalog.portraits[catalog.defaults.portrait];
					var upperSrc = catalog.uppers[upper] || catalog.uppers[catalog.defaults.upper];
					var lowerSrc = catalog.lowers[lower] || catalog.lowers[catalog.defaults.lower];
					if (characterEl && portraitSrc) characterEl.src = portraitSrc;
					if (upperEl && upperSrc) upperEl.src = upperSrc;
					if (lowerEl && lowerSrc) lowerEl.src = lowerSrc;
				}

				function finish() {
					playing = false;
					root.hidden = true;
					root.classList.remove("is-playing", "is-preview", "is-leaving");
					root.setAttribute("aria-hidden", "true");
					document.documentElement.removeAttribute("data-splash-pending");
				}

				function play(detail, isPreview) {
					if (reducedMotion()) {
						finish();
						return;
					}
					if (playing && !isPreview) return;
					if (hideTimer) window.clearTimeout(hideTimer);
					playing = true;
					applyArt(
						(detail && detail.portrait) || storedOr("splashPortrait", catalog.defaults.portrait),
						(detail && detail.upper) || storedOr("splashUpper", catalog.defaults.upper),
						(detail && detail.lower) || storedOr("splashLower", catalog.defaults.lower)
					);
					root.hidden = false;
					root.classList.toggle("is-preview", !!isPreview);
					root.classList.remove("is-leaving");
					root.classList.add("is-playing");
					root.setAttribute("aria-hidden", "false");
					document.documentElement.setAttribute("data-splash-pending", "true");
					hideTimer = window.setTimeout(function () {
						root.classList.add("is-leaving");
						window.setTimeout(function () {
							finish();
						}, 420);
					}, duration);
				}

				function shouldAutoplay() {
					if (!storedEnabled()) return false;
					if (reducedMotion()) return false;
					var isHome = document.body && document.body.classList.contains("is-home");
					if (!isHome) return false;
					try {
						if (sessionStorage.getItem(SESSION_KEY)) return false;
						sessionStorage.setItem(SESSION_KEY, "1");
					} catch (e) {}
					return true;
				}

				if (shouldAutoplay() || document.documentElement.hasAttribute("data-splash-pending")) {
					play(null, false);
				} else {
					finish();
				}

				window.addEventListener("splashPreview", function (event) {
					play(event.detail || {}, true);
				});
				window.addEventListener("splashEnabledChange", function (event) {
					if (event.detail && event.detail.enabled) {
						play(null, true);
					} else {
						finish();
					}
				});
			})();
		</script>
	)
}
