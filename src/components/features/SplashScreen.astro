---
import { atmosphereConfig } from "@/config";
import { url } from "@/utils/url-utils";
import "@/styles/splash.css";

const splash = atmosphereConfig.splash;
const catalog = {
	portraits: Object.fromEntries(
		splash.portraits.map((item) => [
			item.id,
			{
				image: url(item.image),
				ultName: item.ultName,
				ultLines: item.ultLines,
			},
		]),
	),
	uppers: Object.fromEntries(
		splash.upperBanners.map((item) => [item.id, url(item.image)]),
	),
	lowers: Object.fromEntries(
		splash.lowerBanners.map((item) => [item.id, url(item.image)]),
	),
	defaults: {
		portrait: splash.defaultPortrait,
		upper: splash.defaultUpper,
		lower: splash.defaultLower,
	},
};
---

{
	splash.enable && (
		<div
			id="splash-screen"
			class="splash-screen"
			hidden
			data-duration={splash.durationMs}
			aria-hidden="true"
		>
			<div class="splash-upper-clip">
				<img class="splash-upper" data-splash-upper alt="" />
			</div>
			<div class="splash-lower-clip">
				<img class="splash-lower" data-splash-lower alt="" />
			</div>
			<div class="splash-slash">
				<div class="splash-band" aria-hidden="true"></div>
				<div class="splash-title-row">
					<p class="splash-title splash-title-left" data-splash-title-left></p>
					<p class="splash-title splash-title-right" data-splash-title-right></p>
				</div>
			</div>
			<img class="splash-character" data-splash-character alt="" />
			<script type="application/json" id="splash-catalog" set:html={JSON.stringify(catalog)} />
		</div>
	)
}

{
	splash.enable && (
		<script is:inline data-swup-ignore-script>
			(function initSplashScreen() {
				var root = document.getElementById("splash-screen");
				if (!root) return;

				var SESSION_KEY = "stulanez.splash.played";
				var duration = parseInt(root.getAttribute("data-duration") || "4200", 10);
				var catalogNode = document.getElementById("splash-catalog");
				var catalog = { portraits: {}, uppers: {}, lowers: {}, defaults: {} };
				try {
					catalog = JSON.parse(catalogNode && catalogNode.textContent ? catalogNode.textContent : "{}");
				} catch (e) {}
				var hideTimer = 0;
				var playing = false;
				var playSeq = 0;
				var upperEl = root.querySelector("[data-splash-upper]");
				var characterEl = root.querySelector("[data-splash-character]");
				var lowerEl = root.querySelector("[data-splash-lower]");
				var titleLeftEl = root.querySelector("[data-splash-title-left]");
				var titleRightEl = root.querySelector("[data-splash-title-right]");
				var sakuraPoll = 0;
				var sakuraBorrowed = false;

				function reducedMotion() {
					return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				}

				function storedEnabled() {
					try {
						var raw = localStorage.getItem("splashEnabled");
						if (raw === null) return true;
						return raw === "true";
					} catch (e) {
						return true;
					}
				}

				function storedRandom() {
					try {
						return localStorage.getItem("splashRandom") === "true";
					} catch (e) {
						return false;
					}
				}

				function storedOr(key, fallback) {
					try {
						var raw = localStorage.getItem(key);
						if (raw) return raw;
					} catch (e) {}
					return fallback;
				}

				function idsOf(map) {
					return Object.keys(map || {});
				}

				function pickId(map, exceptId) {
					var ids = idsOf(map).filter(function (id) {
						return id !== exceptId;
					});
					if (!ids.length) ids = idsOf(map);
					return ids[Math.floor(Math.random() * ids.length)];
				}

				function resolveSelection(detail) {
					if (detail && detail.portrait) {
						return {
							portrait: detail.portrait,
							upper: detail.upper || storedOr("splashUpper", catalog.defaults.upper),
							lower: detail.lower || storedOr("splashLower", catalog.defaults.lower)
						};
					}
					if (storedRandom()) {
						var upper = pickId(catalog.uppers);
						return {
							portrait: pickId(catalog.portraits),
							upper: upper,
							lower: pickId(catalog.lowers, upper)
						};
					}
					return {
						portrait: storedOr("splashPortrait", catalog.defaults.portrait),
						upper: storedOr("splashUpper", catalog.defaults.upper),
						lower: storedOr("splashLower", catalog.defaults.lower)
					};
				}

				function sakuraWanted() {
					try {
						var raw = localStorage.getItem("sakuraEnabled");
						if (raw !== null) return raw === "true";
					} catch (e) {}
					return document.documentElement.getAttribute("data-sakura-enabled") === "true";
				}

				function clearSakuraPoll() {
					if (sakuraPoll) {
						window.clearInterval(sakuraPoll);
						sakuraPoll = 0;
					}
				}

				function restoreBorrowedSakura() {
					clearSakuraPoll();
					var mgr = window.sakuraManager;
					if (
						sakuraBorrowed &&
						mgr &&
						mgr.getIsRunning &&
						mgr.getIsRunning() &&
						!sakuraWanted()
					) {
						mgr.stop();
						if (mgr.config) mgr.config.enable = false;
					}
					sakuraBorrowed = false;
				}

				function ensureSiteSakura() {
					var mgr = window.sakuraManager;
					if (!mgr) return false;
					if (mgr.getIsRunning && mgr.getIsRunning()) return true;
					if (mgr.config) mgr.config.enable = true;
					if (!sakuraWanted()) sakuraBorrowed = true;
					if (mgr.init) void mgr.init();
					return true;
				}

				function startSiteSakuraForSplash() {
					clearSakuraPoll();
					if (reducedMotion()) return;
					if (ensureSiteSakura()) return;
					sakuraPoll = window.setInterval(function () {
						if (ensureSiteSakura()) clearSakuraPoll();
					}, 50);
				}

				function pickUltLine(entry) {
					var lines = entry && entry.ultLines;
					if (!lines || !lines.length) return "";
					return lines[Math.floor(Math.random() * lines.length)] || "";
				}

				function whenImageReady(img, done) {
					if (!img || !img.src) {
						done();
						return;
					}
					if (img.complete && img.naturalWidth) {
						done();
						return;
					}
					var settled = false;
					function finishReady() {
						if (settled) return;
						settled = true;
						done();
					}
					img.addEventListener("load", finishReady, { once: true });
					img.addEventListener("error", finishReady, { once: true });
					if (img.decode) {
						img.decode().then(finishReady, finishReady);
					}
					window.setTimeout(finishReady, 480);
				}

				function applyArt(portrait, upper, lower) {
					var portraitEntry = catalog.portraits[portrait] || catalog.portraits[catalog.defaults.portrait];
					var upperSrc = catalog.uppers[upper] || catalog.uppers[catalog.defaults.upper];
					var lowerSrc = catalog.lowers[lower] || catalog.lowers[catalog.defaults.lower];
					var portraitSrc = portraitEntry && (portraitEntry.image || portraitEntry);
					if (characterEl && portraitSrc) characterEl.src = portraitSrc;
					if (upperEl && upperSrc) upperEl.src = upperSrc;
					if (lowerEl && lowerSrc) lowerEl.src = lowerSrc;
					if (titleLeftEl) titleLeftEl.textContent = (portraitEntry && portraitEntry.ultName) || "";
					if (titleRightEl) {
						var line = pickUltLine(portraitEntry);
						titleRightEl.textContent = line;
						titleRightEl.setAttribute("data-text", line);
					}
				}

				function finish() {
					playing = false;
					restoreBorrowedSakura();
					root.hidden = true;
					root.classList.remove("is-playing", "is-preview", "is-leaving");
					root.setAttribute("aria-hidden", "true");
					document.documentElement.removeAttribute("data-splash-pending");
				}

				function play(detail, isPreview) {
					if (reducedMotion()) {
						finish();
						return;
					}
					if (playing && !isPreview) return;
					if (hideTimer) window.clearTimeout(hideTimer);
					playing = true;
					var seq = ++playSeq;
					var selection = resolveSelection(detail);
					applyArt(selection.portrait, selection.upper, selection.lower);
					root.hidden = false;
					root.classList.toggle("is-preview", !!isPreview);
					root.classList.remove("is-leaving", "is-playing");
					root.setAttribute("aria-hidden", "false");
					document.documentElement.setAttribute("data-splash-pending", "true");
					startSiteSakuraForSplash();
					whenImageReady(characterEl, function () {
						if (seq !== playSeq) return;
						void root.offsetWidth;
						root.classList.add("is-playing");
						hideTimer = window.setTimeout(function () {
							root.classList.add("is-leaving");
							window.setTimeout(function () {
								finish();
							}, 420);
						}, duration);
					});
				}

				function shouldAutoplay() {
					if (!storedEnabled()) return false;
					if (reducedMotion()) return false;
					var isHome = document.body && document.body.classList.contains("is-home");
					if (!isHome) return false;
					try {
						if (sessionStorage.getItem(SESSION_KEY)) return false;
						sessionStorage.setItem(SESSION_KEY, "1");
					} catch (e) {}
					return true;
				}

				if (shouldAutoplay() || document.documentElement.hasAttribute("data-splash-pending")) {
					play(null, false);
				} else {
					finish();
				}

				window.addEventListener("splashPreview", function (event) {
					play(event.detail || {}, true);
				});
				window.addEventListener("splashEnabledChange", function (event) {
					if (event.detail && event.detail.enabled) {
						play(null, true);
					} else {
						finish();
					}
				});
			})();
		</script>
	)
}
