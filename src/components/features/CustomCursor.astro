---
import { atmosphereConfig } from "@/config";

const enabled = atmosphereConfig.cursor.enable;
---

{
	enabled && (
		<>
			<script is:inline>
				(function initCustomCursor() {
					if (window.__stulanezCursorInit) return;
					window.__stulanezCursorInit = true;
					const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
					function sync() {
						document.documentElement.classList.toggle(
							"custom-cursor-enabled",
							finePointer.matches,
						);
					}
					finePointer.addEventListener("change", sync);
					sync();
				})();
			</script>
			<style is:global>
				html.custom-cursor-enabled {
					--cursor-default: url("/cursors/default.svg") 5 2, auto;
					--cursor-pointer: url("/cursors/pointer.svg") 5 2, pointer;
					--cursor-grab: url("/cursors/grab.svg") 12 8, grab;
					--cursor-grabbing: url("/cursors/grabbing.svg") 12 8, grabbing;
					cursor: var(--cursor-default);
				}
				html.custom-cursor-enabled :is(a, button, summary, label, [role="button"], [role="link"]) {
					cursor: var(--cursor-pointer);
				}
				html.custom-cursor-enabled :is(input, textarea, select, [contenteditable="true"]) {
					cursor: text;
				}
				html.custom-cursor-enabled .is-grab {
					cursor: var(--cursor-grab);
				}
				html.custom-cursor-enabled .is-grab :is(.pick, .card) {
					cursor: var(--cursor-grab);
				}
				html.custom-cursor-enabled .is-grabbing,
				html.custom-cursor-enabled .is-grabbing :is(.pick, .card) {
					cursor: var(--cursor-grabbing) !important;
				}
			</style>
		</>
	)
}
