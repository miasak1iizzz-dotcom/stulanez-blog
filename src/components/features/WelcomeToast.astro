---
import { atmosphereConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

const enabled = atmosphereConfig.welcomeToast.enable;
const timeZone = siteConfig.timezone || "Asia/Shanghai";
const timeoutMs = atmosphereConfig.welcomeToast.locationTimeoutMs;
const greetings = {
	morning: i18n(I18nKey.greetingMorning),
	noon: i18n(I18nKey.greetingNoon),
	afternoon: i18n(I18nKey.greetingAfternoon),
	evening: i18n(I18nKey.greetingEvening),
	night: i18n(I18nKey.greetingNight),
};
const copy = {
	label: i18n(I18nKey.welcomeToastLabel),
	hello: i18n(I18nKey.welcomeToastHello),
	helloCity: i18n(I18nKey.welcomeToastHelloCity),
	body: i18n(I18nKey.welcomeToastBody),
	close: i18n(I18nKey.welcomeToastClose),
};
---

{
	enabled && (
		<div id="welcome-toast" class="welcome-toast" hidden>
			<aside
				class="welcome-toast-card"
				role="dialog"
				aria-labelledby="welcome-toast-title"
				aria-describedby="welcome-toast-body"
			>
				<span class="welcome-toast-icon" aria-hidden="true"></span>
				<div class="welcome-toast-copy">
					<p id="welcome-toast-title" class="welcome-toast-label">
						{copy.label}
					</p>
					<p class="welcome-toast-hello" data-welcome-hello></p>
					<p id="welcome-toast-body" class="welcome-toast-body">
						{copy.body}
					</p>
				</div>
				<button
					type="button"
					class="welcome-toast-close"
					aria-label={copy.close}
					data-welcome-close
				>
					×
				</button>
			</aside>
		</div>
	)
}

{
	enabled && (
		<script is:inline define:vars={{ timeZone, timeoutMs, greetings, copy }}>
			const STORAGE_KEY = "stulanez.welcome.shown";

			function getPeriod(hour) {
				if (hour >= 5 && hour < 11) return "morning";
				if (hour >= 11 && hour < 14) return "noon";
				if (hour >= 14 && hour < 18) return "afternoon";
				if (hour >= 18 && hour < 23) return "evening";
				return "night";
			}

			function getHour() {
				const parts = new Intl.DateTimeFormat("en-US", {
					timeZone,
					hour: "2-digit",
					hourCycle: "h23",
				}).formatToParts(new Date());
				return Number(parts.find((part) => part.type === "hour")?.value || "0");
			}

			function hasShown() {
				try {
					return sessionStorage.getItem(STORAGE_KEY) === "1";
				} catch {
					return true;
				}
			}

			function markShown() {
				try {
					sessionStorage.setItem(STORAGE_KEY, "1");
				} catch {
					// private mode: skip persistence, still close for this page
				}
			}

			async function fetchCity() {
				const controller = new AbortController();
				const timer = setTimeout(() => controller.abort(), timeoutMs);
				try {
					const response = await fetch("https://ipapi.co/json/", {
						signal: controller.signal,
					});
					if (!response.ok) return "";
					const data = await response.json();
					return typeof data.city === "string" ? data.city.trim() : "";
				} catch {
					return "";
				} finally {
					clearTimeout(timer);
				}
			}

			function hideToast(root) {
				root.classList.remove("is-visible");
				window.setTimeout(() => {
					root.hidden = true;
				}, 220);
			}

			function waitForSplash() {
				return new Promise((resolve) => {
					if (!document.documentElement.hasAttribute("data-splash-pending")) {
						resolve();
						return;
					}
					let done = false;
					const finish = () => {
						if (done) return;
						done = true;
						observer.disconnect();
						resolve();
					};
					const observer = new MutationObserver(() => {
						if (!document.documentElement.hasAttribute("data-splash-pending")) {
							finish();
						}
					});
					observer.observe(document.documentElement, {
						attributes: true,
						attributeFilter: ["data-splash-pending"],
					});
					window.setTimeout(finish, 8000);
				});
			}

			async function showWelcome() {
				if (window.__stulanezWelcomeInit) return;
				window.__stulanezWelcomeInit = true;
				if (hasShown()) return;
				const root = document.getElementById("welcome-toast");
				if (!root) return;
				const greeting = greetings[getPeriod(getHour())] || "";
				const city = await fetchCity();
				await waitForSplash();
				const helloEl = root.querySelector("[data-welcome-hello]");
				if (helloEl) {
					helloEl.textContent = city
						? copy.helloCity.replace("{greeting}", greeting).replace("{city}", city)
						: copy.hello.replace("{greeting}", greeting);
				}
				root.hidden = false;
				requestAnimationFrame(() => {
					root.classList.add("is-visible");
				});
				markShown();
				root.querySelector("[data-welcome-close]")?.addEventListener(
					"click",
					() => hideToast(root),
				);
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", () => {
					void showWelcome();
				});
			} else {
				void showWelcome();
			}
		</script>
	)
}

<style>
	.welcome-toast {
		position: fixed;
		right: 1.1rem;
		bottom: 1.1rem;
		z-index: 80;
		width: min(20.5rem, calc(100vw - 1.6rem));
		pointer-events: none;
		opacity: 0;
		translate: 0 0.55rem;
		transition:
			opacity 0.28s ease,
			translate 0.28s ease;
	}

	.welcome-toast.is-visible {
		opacity: 1;
		translate: 0 0;
	}

	.welcome-toast-card {
		pointer-events: auto;
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.72rem 1.85rem 0.72rem 0.72rem;
		border: 1px solid color-mix(in oklch, var(--primary) 16%, transparent);
		border-radius: 1rem;
		background: color-mix(in oklch, var(--card-bg) 86%, transparent);
		box-shadow: 0 10px 28px rgb(15 25 35 / 12%);
		backdrop-filter: blur(16px);
	}

	.welcome-toast-icon {
		flex: 0 0 auto;
		width: 2.15rem;
		height: 2.15rem;
		border-radius: 999px;
		background:
			radial-gradient(circle at 32% 28%, white 0 18%, transparent 20%),
			linear-gradient(
				145deg,
				color-mix(in oklch, var(--primary) 88%, white),
				color-mix(in oklch, var(--primary) 55%, #7c3aed)
			);
		box-shadow: 0 4px 10px color-mix(in oklch, var(--primary) 28%, transparent);
	}

	.welcome-toast-copy {
		min-width: 0;
		flex: 1 1 auto;
	}

	.welcome-toast-label {
		margin: 0;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		color: var(--primary);
	}

	.welcome-toast-hello {
		margin: 0.12rem 0 0;
		font-size: 0.82rem;
		font-weight: 600;
		line-height: 1.35;
		color: oklch(0.25 0.02 var(--hue));
	}

	.dark .welcome-toast-hello {
		color: oklch(0.95 0.01 var(--hue));
	}

	.welcome-toast-body {
		margin: 0.12rem 0 0;
		font-size: 0.72rem;
		line-height: 1.4;
		color: var(--content-meta);
	}

	.welcome-toast-close {
		position: absolute;
		top: 0.28rem;
		right: 0.38rem;
		display: grid;
		place-items: center;
		width: 1.35rem;
		height: 1.35rem;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--content-meta);
		font-size: 1rem;
		line-height: 1;
		cursor: pointer;
	}

	.welcome-toast-close:hover {
		background: color-mix(in oklch, var(--primary) 12%, transparent);
		color: var(--primary);
	}

	.dark .welcome-toast-card {
		background: color-mix(in oklch, var(--card-bg) 78%, transparent);
		box-shadow: 0 10px 28px rgb(0 0 0 / 28%);
	}

	@media (max-width: 640px) {
		.welcome-toast {
			right: 0.75rem;
			bottom: 0.85rem;
			width: min(19.5rem, calc(100vw - 1.2rem));
		}
	}
</style>
