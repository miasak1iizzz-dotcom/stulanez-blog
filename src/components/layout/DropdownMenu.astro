---
import { Icon } from "astro-icon/components";
import DropdownItem from "@/components/common/DropdownItem.astro";
import DropdownPanel from "@/components/common/DropdownPanel.astro";
import type { NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	link: NavBarLink;
	class?: string;
}

const { link, class: className } = Astro.props;

// 检查 link 是否存在
if (!link) {
	return null;
}

const processedLink = link;

const hasChildren = processedLink.children && processedLink.children.length > 0;
---

<div class:list={["dropdown-container", className]} data-dropdown>
	{hasChildren ? (
		<button 
			class="btn-plain scale-animation rounded-lg h-10 font-bold px-4 pr-8 active:scale-95 dropdown-trigger relative"
			aria-expanded="false"
			aria-haspopup="true"
			data-dropdown-trigger
		>
			<div class="flex items-center gap-1.5">
				{processedLink.icon && <Icon name={processedLink.icon} class="text-[1.1rem] mr-1.5 navbar-icon" />}
				{processedLink.name}
			</div>
			<Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-[1.2rem] transition-transform duration-200 dropdown-arrow absolute right-2.5 top-1/2 -translate-y-1/2" />
		</button>
		<div class="dropdown-menu" data-dropdown-menu>
			<DropdownPanel class="dropdown-content">
				{processedLink.children?.map((child, index) => (
					<DropdownItem
						href={child.external ? child.url : url(child.url)}
						target={child.external ? "_blank" : undefined}
						isLast={index === (processedLink.children?.length || 0) - 1}
						class="dropdown-item focus-ring-inset h-10"
						noSwup={Boolean(child.noSwup)}
					>
						{child.icon && <Icon name={child.icon} class="text-[1.25rem] mr-3 navbar-icon" />}
						<span>{child.name}</span>
						{child.external && (
							<Icon name="fa7-solid:arrow-up-right-from-square" class="text-[0.75rem] text-black/25 dark:text-white/25 ml-auto" />
						)}
					</DropdownItem>
				))}
			</DropdownPanel>
		</div>
	) : (
		<a 
			aria-label={processedLink.name} 
			href={processedLink.external ? processedLink.url : url(processedLink.url)} 
			target={processedLink.external ? "_blank" : null}
			data-no-swup={processedLink.noSwup ? "" : undefined}
			class="btn-plain scale-animation rounded-lg h-10 font-bold px-4 active:scale-95"
		>
			<div class="flex items-center gap-1.5">
				{processedLink.icon && <Icon name={processedLink.icon} class="text-[1.1rem] mr-1.5 navbar-icon" />}
				{processedLink.name}
				{processedLink.external && <Icon name="fa7-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-px ml-1 text-black/20 dark:text-white/20" />}
			</div>
		</a>
	)}
</div>

<style>
	@reference "../../styles/main.css";

	.dropdown-container {
		@apply relative;
	}

	.dropdown-menu {
		@apply absolute top-full left-0 pt-2 pointer-events-none z-50;
	}

	.dropdown-container:hover .dropdown-menu,
	.dropdown-container:focus-within .dropdown-menu,
	.dropdown-container.is-open .dropdown-menu {
		@apply pointer-events-auto;
	}

	.dropdown-container:hover .dropdown-arrow,
	.dropdown-container:focus-within .dropdown-arrow,
	.dropdown-container.is-open .dropdown-arrow {
		@apply rotate-180;
	}

	/* 移动端隐藏下拉菜单 */
	@media (max-width: 768px) {
		.dropdown-container {
			@apply hidden;
		}
	}
</style>

<script>
	function closeDesktopDropdown(dropdown: Element) {
		dropdown.classList.remove("is-open");
		dropdown
			.querySelector("[data-dropdown-trigger]")
			?.setAttribute("aria-expanded", "false");
	}

	function openDesktopDropdown(dropdown: Element) {
		dropdown.classList.add("is-open");
		dropdown
			.querySelector("[data-dropdown-trigger]")
			?.setAttribute("aria-expanded", "true");
	}

	function closeAllDesktopDropdowns(except?: Element | null) {
		document.querySelectorAll("[data-dropdown]").forEach((dropdown) => {
			if (dropdown !== except) closeDesktopDropdown(dropdown);
		});
	}

	function bindDesktopDropdowns() {
		if (window.__stulanezDesktopDropdownBound) return;
		window.__stulanezDesktopDropdownBound = true;

		document.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;

			const trigger = target.closest("[data-dropdown-trigger]");
			if (trigger instanceof HTMLElement) {
				const dropdown = trigger.closest("[data-dropdown]");
				if (!(dropdown instanceof HTMLElement)) return;
				event.preventDefault();
				const willOpen = !dropdown.classList.contains("is-open");
				closeAllDesktopDropdowns();
				if (willOpen) openDesktopDropdown(dropdown);
				return;
			}

			closeAllDesktopDropdowns();
		});

		document.addEventListener("keydown", (event) => {
			const target = event.target;
			if (event.key === "Escape") {
				closeAllDesktopDropdowns();
				return;
			}
			if (!(target instanceof HTMLElement)) return;

			if (target.matches("[data-dropdown-trigger]")) {
				const dropdown = target.closest("[data-dropdown]");
				if (!dropdown) return;
				const items = dropdown.querySelectorAll(
					".dropdown-item",
				) as NodeListOf<HTMLElement>;
				if (event.key === "Enter" || event.key === " ") {
					event.preventDefault();
					const willOpen = !dropdown.classList.contains("is-open");
					closeAllDesktopDropdowns();
					if (willOpen) openDesktopDropdown(dropdown);
				} else if (event.key === "ArrowDown") {
					event.preventDefault();
					openDesktopDropdown(dropdown);
					items[0]?.focus();
				}
				return;
			}

			if (!target.classList.contains("dropdown-item")) return;
			const dropdown = target.closest("[data-dropdown]");
			if (!dropdown) return;
			const items = Array.from(
				dropdown.querySelectorAll(".dropdown-item"),
			) as HTMLElement[];
			const index = items.indexOf(target);
			if (index < 0) return;
			if (event.key === "ArrowDown") {
				event.preventDefault();
				items[(index + 1) % items.length]?.focus();
			} else if (event.key === "ArrowUp") {
				event.preventDefault();
				items[(index - 1 + items.length) % items.length]?.focus();
			}
		});
	}

	bindDesktopDropdowns();
</script>
