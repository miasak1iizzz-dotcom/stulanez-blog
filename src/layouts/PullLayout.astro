---
import HeaderTopRow from "@/components/layout/HeaderTopRow.astro";
import PageAtmosphere from "@/components/misc/PageAtmosphere.astro";
import { siteConfig } from "@/config";
import Layout from "@/layouts/Layout.astro";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;
---

<Layout {title} {description}>
	<HeaderTopRow stickyNavbar={true} {navbarWidthFull} />
	<PageAtmosphere />
	<div id="banner-overlay-container" hidden></div>
	<div id="banner-dim-container" hidden></div>
	<div id="left-sidebar-dynamic" hidden></div>
	<div id="right-sidebar-dynamic" hidden></div>
	<div id="floating-toc-wrapper" hidden></div>
	<main class="pull-tool-main">
		<slot />
	</main>
</Layout>

<style is:global>
	body:has(.pull-tool-main) {
		background: #fff8f6 !important;
		color: #201a19;
		color-scheme: light;
	}

	.pull-tool-main {
		min-height: 100vh;
		padding: 0.7rem 0.55rem 4.6rem;
		color: #201a19;
		background:
			radial-gradient(#e8d4d0 0.9px, transparent 0.9px) 0 0 / 18px 18px,
			#fff8f6;
		transition: padding-top 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	body:has(.pull-tool-main).site-nav-pinned .pull-tool-main,
	body:has(.pull-tool-main).site-nav-at-top.site-nav-open .pull-tool-main,
	body:has(.pull-tool-main).pull-nav-pinned .pull-tool-main,
	body:has(.pull-tool-main).pull-nav-at-top.pull-nav-open .pull-tool-main {
		padding-top: 5.6rem;
	}
</style>
